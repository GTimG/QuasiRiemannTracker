{
  "name": "qrh-bounds",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "node scripts/catalogue.mjs && node verifier/registry.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "verify": "node verifier/cli.mjs",
    "test:integration": "node verifier/integration.mjs",
    "check": "npm run check:publication && npm test && npm run build",
    "format": "prettier --write src core verifier tests .github schemas worker/*.json *.json *.ts *.md docs",
    "configure-repository": "node scripts/configure-repository.mjs",
    "check:publication": "python3 scripts/publication_policy.py"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "better-react-mathjax": "^3.0.2",
    "lucide-react": "0.468.0",
    "mathjax": "^3.2.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.1.9"
  }
}
