theorem bernstein_margin_0 {t v : ℝ} (ht : 0 ≤ t) (ht1 : t ≤ 1)
    (hv : 0 ≤ v) (hv1 : v ≤ 1) :
    (1 / 200000000000000000000000 : ℝ) < F (t / 4) (v / 2) := by
  have ht' : 0 ≤ 1 - t := sub_nonneg.mpr ht1
  have hv' : 0 ≤ 1 - v := sub_nonneg.mpr hv1
  rw [bernstein_identity_0]
  repeat' apply lt_of_lt_of_le ?_ (le_add_of_nonneg_right (by positivity))
  norm_num

