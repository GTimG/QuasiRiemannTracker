      y ^ 1 * ((524212589531889290721237681423306292352550933350763564764974282747687561314408086567825455965156544304008741 / 172856456428145449796928509077067333778188557849907689671779525433345532031656329366000000000000000000000000000 : ℝ) * (δ - 1 / 3) ^ 0 + (359638523800744788169352526666143586876601366739441702468047811066241595035961252153517355198890683787476261 / 3201045489410100922165342760686432107003491812035327586514435656173065407993635729000000000000000000000000000 : ℝ) * (δ - 1 / 3) ^ 1 + (726995745936118747835382858730504150220876567118103262530828365740969603128067507959121897636412583681388237 / 1200392058528787845812003535257412040126309429513247844942913371064899527997613398375000000000000000000000000 : ℝ) * (δ - 1 / 3) ^ 2) +
      y ^ 2 * ((601145972024165417081583222584562885921133445250417507836668733122960998716950790826309734928569596708373831 / 14404704702345454149744042423088944481515713154158974139314960452778794335971360780500000000000000000000000000 : ℝ) * (δ - 1 / 3) ^ 0 + (3888695041764889595812255974968503333945979597889212501827125207997423114274787516330051834724482730160870491 / 14404704702345454149744042423088944481515713154158974139314960452778794335971360780500000000000000000000000000 : ℝ) * (δ - 1 / 3) ^ 1 + (1042628562846196672283753153607407338091289631068979989158559504314270059061967571925561314969386970017874499 / 2400784117057575691624007070514824080252618859026495689885826742129799055995226796750000000000000000000000000 : ℝ) * (δ - 1 / 3) ^ 2) +
      y ^ 3 * ((500515766958812646456744524 / 30371518573028014636416974463 : ℝ) * (δ - 1 / 3) ^ 0 + (1001031533917625292913489048 / 10123839524342671545472324821 : ℝ) * (δ - 1 / 3) ^ 1 + (500515766958812646456744524 / 3374613174780890515157441607 : ℝ) * (δ - 1 / 3) ^ 2) := by
  norm_num [F, J, D, P, c, kappa0, tightTheta, h, lx, ly, M, ell, b, Av, Dv, dv]
  <;> ring

theorem near_margin {δ y : ℝ} (hδ : (1 / 3 : ℝ) ≤ δ) (hy : 0 ≤ y) :
    (1 / 200000000000000000000000 : ℝ) < F δ y := by
  have hu : 0 ≤ δ - 1 / 3 := sub_nonneg.mpr hδ
  have hA := Av_pos.le
  rw [square_identity]
  apply lt_of_lt_of_le Dv_margin
  iterate 3 apply le_trans ?_ (le_add_of_nonneg_right (by positivity))
  exact le_add_of_nonneg_left (by positivity)

