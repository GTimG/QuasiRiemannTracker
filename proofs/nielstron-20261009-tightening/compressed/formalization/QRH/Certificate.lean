theorem bernstein_margin_1 {t v : ℝ} (ht : 0 ≤ t) (ht1 : t ≤ 1)
    (hv : 0 ≤ v) (hv1 : v ≤ 1) :
    (1 / 200000000000000000000000 : ℝ) < F (1 / 4 + t / 12) (v / 2) := by
  have ht' : 0 ≤ 1 - t := sub_nonneg.mpr ht1
  have hv' : 0 ≤ 1 - v := sub_nonneg.mpr hv1
  rw [bernstein_identity_1]
  repeat' apply lt_of_lt_of_le ?_ (le_add_of_nonneg_right (by positivity))
  norm_num

theorem continuous_margin {δ y : ℝ} (hδ : 0 ≤ δ)
    (hy : 0 ≤ y) (hy1 : y ≤ 1 / 2) :
    (1 / 200000000000000000000000 : ℝ) < F δ y := by
  by_cases hd0 : δ ≤ 1 / 4
  · have hh := bernstein_margin_0 (t := 4 * δ) (v := 2 * y)
      (by linarith) (by linarith) (by linarith) (by linarith)
    convert hh using 1 <;> congr 1 <;> ring
  · by_cases hd1 : δ ≤ 1 / 3
    · have hh := bernstein_margin_1 (t := 12 * (δ - 1 / 4)) (v := 2 * y)
        (by linarith) (by linarith) (by linarith) (by linarith)
      convert hh using 1 <;> congr 1 <;> ring
    · exact near_margin (by linarith) hy

section
variable {δ x : ℝ}
include δ x

theorem denominator_bounds
    (hd0 : 0 ≤ δ) (hd1 : δ ≤ 5 / 6) (hx0 : 0 ≤ x) (hx1 : x ≤ 1 / 2) :
    (25 / 39 : ℝ) ≤ J δ x ∧ J δ x ≤ 5 / 2 := by
  have bounds : (10 / 13 : ℝ) ≤ P x ∧ P x ≤ D x ∧ D x ≤ 3 := by
    norm_num [P, D, c, kappa0, tightTheta]
    refine ⟨?_, ?_, hx0⟩ <;>
      nlinarith [sq_nonneg (x - 1 / 2), mul_nonneg hx0 (sub_nonneg.mpr hx1)]
  have hweight : 0 ≤ 5 / 6 - δ := by linarith
  have hl0 := mul_le_mul_of_nonneg_left (bounds.1.trans bounds.2.1) hweight
  have hl1 := mul_le_mul_of_nonneg_left bounds.1 hd0
  have hu0 := mul_le_mul_of_nonneg_left bounds.2.2 hweight
  have hu1 := mul_le_mul_of_nonneg_left (bounds.2.1.trans bounds.2.2) hd0
  dsimp [J]
  constructor <;> nlinarith

theorem F_E_identity (hj : J δ x ≠ 0) :
    F δ (1 / 2 - x) = -J δ x * E δ x := by
  simp only [F, E, sub_sub_cancel]
  field_simp
  <;> ring

/-- Exact strict saving over the entire closed rectangle, including its boundary. -/
theorem endpoint_saving (hd0 : 0 ≤ δ) (hd1 : δ ≤ 5 / 6)
    (hx0 : 0 ≤ x) (hx1 : x ≤ 1 / 2) :
    E δ x < -(1 / 500000000000000000000000 : ℝ) := by
  have hj := denominator_bounds hd0 hd1 hx0 hx1
  have hjpos : 0 < J δ x := by linarith [hj.1]
  have hf := continuous_margin hd0 (show 0 ≤ 1 / 2 - x by linarith)
    (show 1 / 2 - x ≤ 1 / 2 by linarith)
  rw [F_E_identity hjpos.ne'] at hf
  nlinarith [hj.2]

end



