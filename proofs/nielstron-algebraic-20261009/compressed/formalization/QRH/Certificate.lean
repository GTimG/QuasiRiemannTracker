theorem low_nonneg_1 {w t v : ℝ} (hw : 0 ≤ w) (hw1 : w ≤ 1)
    (ht : 0 ≤ t) (ht1 : t ≤ 1) (hv : 0 ≤ v) (hv1 : v ≤ 1) :
    0 ≤ scaledF (1/6+w/3000) (1/4+t/12) (v/2) := by
  have hw' : 0 ≤ 1-w := sub_nonneg.mpr hw1
  have ht' : 0 ≤ 1-t := sub_nonneg.mpr ht1
  have hv' : 0 ≤ 1-v := sub_nonneg.mpr hv1
  rw [low_identity_1]
  positivity

theorem scaled_nonneg {e d y : ℝ} (he : e ∈ Set.Icc (1/6:ℝ) (167/1000:ℝ))
    (hc : 0 ≤ Algebraic.cubic e) (hd : 0 ≤ d) (hy : 0 ≤ y) (hy1 : y ≤ 1/2) :
    0 ≤ scaledF e d y := by
  let w := 3000*(e-1/6)
  have hw : 0 ≤ w := by dsimp [w]; linarith [he.1]
  have hw1 : w ≤ 1 := by dsimp [w]; linarith [he.2]
  have hew : 1/6+w/3000=e := by dsimp [w]; ring
  by_cases hd0 : d ≤ 1/4
  · have hh := low_nonneg_0 hw hw1 (t:=4*d) (v:=2*y)
      (by linarith) (by linarith) (by linarith) (by linarith)
    rw [hew] at hh
    convert hh using 1 <;> congr 1 <;> ring
  · by_cases hd1 : d ≤ 1/3
    · have hh := low_nonneg_1 hw hw1 (t:=12*(d-1/4)) (v:=2*y)
        (by linarith) (by linarith) (by linarith) (by linarith)
      rw [hew] at hh
      convert hh using 1 <;> congr 1 <;> ring
    · have hh := near_nonneg hw hw1 (d:=d) (y:=y) (by linarith) hy (by rwa [hew])
      rwa [hew] at hh


def scale : ℝ := 36*(5-3*ell)*(3*ell+1)*(-114*ell^2+159*ell+7)

theorem ell_denominators : 0 < 5-3*ell ∧ 0 < -114*ell^2+159*ell+7 := by
  have he := ell_interval
  have he2 : ell^2 ≤ (167/1000:ℝ)^2 := by nlinarith [he.1,he.2]
  constructor <;> nlinarith [he.1,he.2]

theorem scale_pos : 0 < scale := by
  have hh : 0 < 3*ell+1 := by linarith [ell_interval.1]
  unfold scale
  exact mul_pos (mul_pos (mul_pos (by norm_num) ell_denominators.1) hh) ell_denominators.2

theorem scaled_identity (δ y : ℝ) : scale*F δ y = scaledF ell δ y := by
  have ht : tightTheta = 11/12-ell/4 := by unfold ell; ring
  have hq : 114*ell^2-159*ell-7 ≠ 0 := by linarith [ell_denominators.2]
  have hk : 3*(2*(11/12-ell/4)-1) ≠ 0 := by linarith [ell_denominators.1]
  unfold scale F J D P c kappa0 h lx ly M b scaledF
  rw [ht]
  field_simp (disch := nlinarith [ell_denominators.1, ell_denominators.2])
  ring

theorem continuous_nonneg {δ y : ℝ} (hδ : 0 ≤ δ) (hy : 0 ≤ y) (hy1 : y ≤ 1/2) :
    0 ≤ F δ y := by
  have hh := scaled_nonneg ell_interval (by rw [ell_cubic]) hδ hy hy1
  rw [← scaled_identity] at hh
  exact nonneg_of_mul_nonneg_right hh scale_pos

theorem c_bounds : (4/9:ℝ) ≤ c ∧ c ≤ 6/13 := by
  have hk : 0 < 3*kappa0 := by linarith [NumericFacts.kappa_lower]
  unfold c
  constructor
  · apply (le_div_iff₀ hk).mpr
    linarith [NumericFacts.kappa_upper]
  · apply (div_le_iff₀ hk).mpr
    linarith [NumericFacts.kappa_lower]

section
variable {δ x : ℝ}
include δ x

theorem denominator_bounds
    (hd0 : 0 ≤ δ) (hd1 : δ ≤ 5/6) (hx0 : 0 ≤ x) (hx1 : x ≤ 1/2) :
    (25/39:ℝ) ≤ J δ x ∧ J δ x ≤ 5/2 := by
  have hc0 : 0 ≤ c := by linarith [c_bounds.1]
  have hcx : c*x ≤ (3/13:ℝ) := by
    have hh := mul_le_mul c_bounds.2 hx1 hx0 (by norm_num : (0:ℝ) ≤ 6/13)
    norm_num at hh
    exact hh
  have hcx2 : c*x*x ≤ (3/26:ℝ) := by
    have hh := mul_le_mul hcx hx1 hx0 (by norm_num : (0:ℝ) ≤ 3/13)
    norm_num at hh
    exact hh
  have hp : (10/13:ℝ) ≤ P x := by
    have h0 : (20/13:ℝ) ≤ 2-2*c*x := by linarith
    have h1 : (1/2:ℝ) ≤ 1-x := by linarith
    have hh := mul_le_mul h0 h1 (by norm_num : (0:ℝ) ≤ 1/2) (by linarith)
    dsimp [P]
    norm_num at hh
    exact hh
  have hpd : P x ≤ D x := by dsimp [P,D]; nlinarith
  have hd : D x ≤ 3 := by
    dsimp [D]
    nlinarith [mul_nonneg hc0 hx0]
  have hweight : 0 ≤ 5/6-δ := by linarith
  have hl0 := mul_le_mul_of_nonneg_left (hp.trans hpd) hweight
  have hl1 := mul_le_mul_of_nonneg_left hp hd0
  have hu0 := mul_le_mul_of_nonneg_left hd hweight
  have hu1 := mul_le_mul_of_nonneg_left (hpd.trans hd) hd0
  dsimp [J]
  constructor <;> nlinarith

theorem F_E_identity (hj : J δ x ≠ 0) :
    F δ (1/2-x) = -J δ x*E δ x := by
  simp only [F,E,sub_sub_cancel]
  field_simp
  <;> ring

/-- The limiting algebraic geometry has a nonpositive endpoint exponent. -/
theorem endpoint_nonpos (hd0 : 0 ≤ δ) (hd1 : δ ≤ 5/6)
    (hx0 : 0 ≤ x) (hx1 : x ≤ 1/2) : E δ x ≤ 0 := by
  have hj := denominator_bounds hd0 hd1 hx0 hx1
  have hjpos : 0 < J δ x := by linarith [hj.1]
  have hf := continuous_nonneg hd0 (show 0 ≤ 1/2-x by linarith)
    (show 1/2-x ≤ 1/2 by linarith)
  rw [F_E_identity hjpos.ne'] at hf
  nlinarith

end
