theorem near_nonneg {w d y : ℝ} (hw : 0 ≤ w) (hw1 : w ≤ 1)
    (hd : 1/3 ≤ d) (hy : 0 ≤ y) (hc : 0 ≤ Algebraic.cubic (1/6+w/3000)) :
    0 ≤ scaledF (1/6+w/3000) d y := by
  have hw' : 0 ≤ 1-w := sub_nonneg.mpr hw1
  have hd' : 0 ≤ d-1/3 := sub_nonneg.mpr hd
  rw [near_identity]
  positivity

