theorem continuous_margin {δ y : ℝ} (hδ : 0 ≤ δ)
    (hy : 0 ≤ y) (hy1 : y ≤ 1 / 2) :
    (5 / 1000000000000 : ℝ) < F δ y := by
  by_cases hd0 : δ ≤ 1 / 4
  · have hh := bernstein_margin_0 (t := 4 * δ) (v := 2 * y)
      (by linarith) (by linarith) (by linarith) (by linarith)
    convert hh using 1 <;> congr 1 <;> ring
  · by_cases hd1 : δ ≤ 1 / 3
    · have hh := bernstein_margin_1 (t := 12 * (δ - 1 / 4)) (v := 2 * y)
        (by linarith) (by linarith) (by linarith) (by linarith)
      convert hh using 1 <;> congr 1 <;> ring
    · exact near_margin (by linarith) hy

theorem denominator_bounds {δ x : ℝ}
    (hd0 : 0 ≤ δ) (hd1 : δ ≤ 5 / 6) (hx0 : 0 ≤ x) (hx1 : x ≤ 1 / 2) :
    (25 / 39 : ℝ) ≤ J δ x ∧ J δ x ≤ 5 / 2 := by
  have hc0 : 0 ≤ c := by norm_num [c, kappa0, theta]
  have hc1 : c ≤ (6 / 13 : ℝ) := by norm_num [c, kappa0, theta]
  have hcx0 : 0 ≤ c * x := mul_nonneg hc0 hx0
  have hcx1 : c * x ≤ (3 / 13 : ℝ) := by
    calc c * x ≤ (6 / 13 : ℝ) * x := mul_le_mul_of_nonneg_right hc1 hx0
         _ ≤ 3 / 13 := by linarith
  have hp : (10 / 13 : ℝ) ≤ P x := by
    have hprod := mul_le_mul (show (20 / 13 : ℝ) ≤ 2 - 2 * c * x by linarith)
      (show (1 / 2 : ℝ) ≤ 1 - x by linarith) (by norm_num : (0 : ℝ) ≤ 1 / 2)
      (show 0 ≤ 2 - 2 * c * x by linarith)
    dsimp [P]
    nlinarith [hprod]
  have hpd : P x ≤ D x := by
    have hh := mul_nonneg hx0 (show 0 ≤ 1 - 2 * c * x by linarith)
    dsimp [P, D]
    nlinarith [hh]
  have hd : D x ≤ 3 := by
    dsimp [D]
    nlinarith
  have hweight : 0 ≤ 5 / 6 - δ := by linarith
  have hl0 := mul_le_mul_of_nonneg_left (hp.trans hpd) hweight
  have hl1 := mul_le_mul_of_nonneg_left hp hd0
  have hu0 := mul_le_mul_of_nonneg_left hd hweight
  have hu1 := mul_le_mul_of_nonneg_left (hpd.trans hd) hd0
  dsimp [J]
  constructor <;> nlinarith

theorem F_E_identity {δ x : ℝ} (hj : J δ x ≠ 0) :
    F δ (1 / 2 - x) = -J δ x * E δ x := by
  unfold F E
  have hx : (1 / 2 : ℝ) - (1 / 2 - x) = x := by ring
  rw [hx]
  field_simp
  <;> ring

/-- Exact strict saving over the entire closed rectangle, including its boundary. -/
theorem endpoint_saving {δ x : ℝ} (hd0 : 0 ≤ δ) (hd1 : δ ≤ 5 / 6)
    (hx0 : 0 ≤ x) (hx1 : x ≤ 1 / 2) :
    E δ x < -(2 / 1000000000000 : ℝ) := by
  have hj := denominator_bounds hd0 hd1 hx0 hx1
  have hjpos : 0 < J δ x := by linarith [hj.1]
  have hf := continuous_margin hd0 (show 0 ≤ 1 / 2 - x by linarith)
    (show 1 / 2 - x ≤ 1 / 2 by linarith)
  rw [F_E_identity hjpos.ne'] at hf
  nlinarith [hj.2]

/-- Dynamic-kappa count loss and the extension to h+zeta preserve a common saving. -/
theorem post_extension_saving {δ x Δ : ℝ} (hd0 : 0 ≤ δ) (hd1 : δ ≤ 5 / 6)
    (hx0 : 0 ≤ x) (hx1 : x ≤ 1 / 2) (hΔ : 0 ≤ Δ) :
    E δ x + h * Δ / 4 - Δ + 2 * zeta < -(1 / 1000000000000 : ℝ) := by
  have hh : h < (82 / 100 : ℝ) := by norm_num [h, lx, M, b, ell, theta]
  have hprod := mul_nonneg hΔ (show 0 ≤ 1 - h / 4 by linarith)
  have he := endpoint_saving hd0 hd1 hx0 hx1
  norm_num [zeta] at *
  nlinarith

end
end QRH.Certificate
