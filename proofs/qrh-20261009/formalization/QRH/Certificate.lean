import QRH.Geometry
import Mathlib.Tactic.Positivity
import Mathlib.Tactic.FieldSimp

/-! Continuous rational exponent certificate. No analytic conclusion is asserted. -/
namespace QRH.Certificate
noncomputable section
open QRH

def c : ℝ := 1 / (3 * kappa0)
def D (x : ℝ) : ℝ := 3 - (1 + 2 * c) * x
def P (x : ℝ) : ℝ := (2 - 2 * c * x) * (1 - x)
def J (δ x : ℝ) : ℝ := (5 / 6 - δ) * D x + δ * P x

def F (δ y : ℝ) : ℝ :=
  -J δ (1 / 2 - y) * ((1 + δ) / 2 - theta - h / 6 -
    (1 + δ) / 2 * ly - ell / 2 + (1 / 2 - y) * δ * ell + h * (1 - δ / 2)) -
    h * (5 / 6 - δ) * δ * P (1 / 2 - y) / 2

def E (δ x : ℝ) : ℝ :=
  (1 + δ) / 2 - theta - h / 6 - (1 + δ) / 2 * ly - ell / 2 + x * δ * ell +
    h * (1 - δ + (5 / 6 - δ) * δ * P x / (2 * J δ x) + δ / 2)

def Av : ℝ := (22980714297137324206149579501325032476327674391 / 97001378465812651372080867785292379000000000000 : ℝ)
def Dv : ℝ := (11468905885308989336086113609703310393394156585533 / 1964953320349168109317400115833592633639660605442000000000000 : ℝ)
def dv : ℝ := (874613174789 / 2250773650422 : ℝ)

theorem Av_pos : 0 < Av := by norm_num [Av]
theorem Dv_margin : (5 / 1000000000000 : ℝ) < Dv := by norm_num [Dv]

theorem square_identity (δ y : ℝ) :
    F δ y = Av * (δ - dv) ^ 2 + Dv +
      y ^ 1 * ((47655690054672811310768671049616269603730713471 / 15714223311461649522277100581217365398000000000000 : ℝ) * (δ - 1 / 3) ^ 0 + (98083233764193411159067931457873357482655419773 / 873012406192313862348727810067631411000000000000 : ℝ) * (δ - 1 / 3) ^ 1 + (66090522357236113351990198326622999204915257847 / 109126550774039232793590976258453926375000000000 : ℝ) * (δ - 1 / 3) ^ 2) +
      y ^ 2 * ((54649633819311606819745866920167325971807856261 / 1309518609288470793523091715101447116500000000000 : ℝ) * (δ - 1 / 3) ^ 0 + (353517731063908646350315646872573955319830302721 / 1309518609288470793523091715101447116500000000000 : ℝ) * (δ - 1 / 3) ^ 1 + (94784414802986912945539023056035988702203366969 / 218253101548078465587181952516907852750000000000 : ℝ) * (δ - 1 / 3) ^ 2) +
      y ^ 3 * ((500515766948 / 30371518573101 : ℝ) * (δ - 1 / 3) ^ 0 + (1001031533896 / 10123839524367 : ℝ) * (δ - 1 / 3) ^ 1 + (500515766948 / 3374613174789 : ℝ) * (δ - 1 / 3) ^ 2) := by
  norm_num [F, J, D, P, c, kappa0, theta, h, lx, ly, M, ell, b, Av, Dv, dv]
  <;> ring

theorem near_margin {δ y : ℝ} (hδ : (1 / 3 : ℝ) ≤ δ) (hy : 0 ≤ y) :
    (5 / 1000000000000 : ℝ) < F δ y := by
  have hu : 0 ≤ δ - 1 / 3 := sub_nonneg.mpr hδ
  have hv : 0 ≤ Av * (δ - dv) ^ 2 := mul_nonneg Av_pos.le (sq_nonneg _)
  have hrest : 0 ≤ y ^ 1 * ((47655690054672811310768671049616269603730713471 / 15714223311461649522277100581217365398000000000000 : ℝ) * (δ - 1 / 3) ^ 0 + (98083233764193411159067931457873357482655419773 / 873012406192313862348727810067631411000000000000 : ℝ) * (δ - 1 / 3) ^ 1 + (66090522357236113351990198326622999204915257847 / 109126550774039232793590976258453926375000000000 : ℝ) * (δ - 1 / 3) ^ 2) +
      y ^ 2 * ((54649633819311606819745866920167325971807856261 / 1309518609288470793523091715101447116500000000000 : ℝ) * (δ - 1 / 3) ^ 0 + (353517731063908646350315646872573955319830302721 / 1309518609288470793523091715101447116500000000000 : ℝ) * (δ - 1 / 3) ^ 1 + (94784414802986912945539023056035988702203366969 / 218253101548078465587181952516907852750000000000 : ℝ) * (δ - 1 / 3) ^ 2) +
      y ^ 3 * ((500515766948 / 30371518573101 : ℝ) * (δ - 1 / 3) ^ 0 + (1001031533896 / 10123839524367 : ℝ) * (δ - 1 / 3) ^ 1 + (500515766948 / 3374613174789 : ℝ) * (δ - 1 / 3) ^ 2) := by positivity
  rw [square_identity]
  linarith [Dv_margin]

