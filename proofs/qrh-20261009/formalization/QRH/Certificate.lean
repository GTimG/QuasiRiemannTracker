      (1338554220201224449914992410449553804912071615781 / 125713786491693196178216804649738923184000000000000 : ℝ) * (2*t*(1-t)) * (3*v^2*(1-v)) +
      (19968081249262566858644094714335309 / 2069599947548120530206392000000000000 : ℝ) * (2*t*(1-t)) * v^3 +
      (32073457698117007637408336919739918878634835737 / 8380919099446213078547786976649261545600000000000 : ℝ) * t^2 * (1-v)^3 +
