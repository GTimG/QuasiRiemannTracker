/-- Fixed finite enclosure; its exponent does not depend on the live slot
set, the profiles, the height, or the restoration assignments. -/
def primeEnclosure (Z : ℝ) : Finset PrimeIdeal := enclosure (4*Z^(2:ℝ))

def raisedProfile (p : Profiles (1/4) (9/4)) (t : ℝ) (j : Fin 2) : 𝓢(ℝ,ℂ) :=
  normPowerProfile (p.profile j) (1/4) (9/4) (by norm_num)
    (p.support j) ((p.profile j).smooth ⊤) t

/-- The radial weight includes the original nonprincipal row restriction.
In particular the zero row never asks for a natural-character identity. -/
def initialWeight (η η₀ : Character) (Q : Id) (Φ : 𝓢(ℝ,ℂ))
    (Z : ℝ) (z : O) : ℝ :=
  if initialKeep η (internalQ Q η₀) z then (Φ (‖eisEmbedding z‖^2/Z)).re else 0

variable {α : Type*} [Fintype α] [DecidableEq α]
variable (rayM : Id) [NeZero rayM]
local instance : Finite (O⧸rayM) := Ring.HasFiniteQuotients.finiteQuotient (NeZero.ne rayM)
variable (H : Subgroup (O⧸rayM)ˣ) (hH : RayOrthogonality.globalUnits rayM ≤ H)

def initialPool {ι : Type*} (w : ι → ℝ) (Z : ℝ) (i : ι) : Finset Id :=
  supportedPool (CenteredMomentPrimeSlot.primePool rayM H 2 (Z^(w i)))

def rawCoefficient {ι : Type*} (η₀ : Character)
    (θ : ι → RayQuotient.Characters rayM H) (W : ℝ → ℂ)
    (w σ v : ι → ℝ) (Z : ℝ) (i : ι) (I : Id) : ℂ :=
  idealCoeff (relativeCharacter rayM H hH η₀ (θ i)) I *
    HeckePrimeAnnular.annularWeight W (Z^(w i)) (σ i) (v i) I

def initialCoefficient {ι : Type*} (η₀ : Character)
    (θ : ι → RayQuotient.Characters rayM H) (W : ℝ → ℂ)
    (w σ v : ι → ℝ) (Z t : ℝ) (i : ι) : Id → ℂ :=
  heightCoefficient (rawCoefficient rayM H hH η₀ θ W w σ v Z i) t

/-- The restricted moment input at one scale. The only coefficients allowed
are the original annular coefficients followed by the two masks generated by
collision and inverse restoration. The ordinary profiles are the unchanged
original ones with their common height. The smaller positive ordinary lengths
are not artificially rounded up to one. -/
def RestrictedInitialAt (face : SourceFace) (W : ℝ → ℂ)
    (bΦ mesh ε Z : ℝ) (η η₀ : Character) (Q : Id)
    (degree : ℕ) (controls : Finset (ℕ×ℕ)) (C : ℝ) : Prop :=
  ∀ (T : Finset α) (θ : T → RayQuotient.Characters rayM H)
    (w σ v : T → ℝ) (t height : ℝ),
    (∀ i, 0 ≤ w i) → (∀ i, w i ≤ mesh) →
    (∀ i, (33/50:ℝ) ≤ σ i) → (∀ i, σ i ≤ (33/50:ℝ)) →
    0 ≤ height → (∀ i, |v i| ≤ height) →
  ∀ Φ : 𝓢(ℝ,ℂ), Function.support (Φ : ℝ → ℂ) ⊆ Set.Iic bΦ →
    (∀ x, 0 ≤ (Φ x).re) →
  ∀ (p : Profiles (1/4) (9/4)) (X₁ X₂ : ℝ), 0 < X₁ → 0 < X₂ →
    face.Admissible (length Z X₁) (length Z X₂) (∑ i, w i) 1 →
  ∀ (rows : Finset O) (r : Setoid T)
    (tc : {q // ¬singletonBlock r q} → primeEnclosure Z)
    (A : Finset {q // singletonBlock r q}) (ti : A → primeEnclosure Z),
    Function.Injective ti →
  ∀ Y₁ Y₂ : ℝ, 0 < Y₁ → Y₁ ≤ X₁ → 0 < Y₂ → Y₂ ≤ X₂ →
    (∑ z ∈ rows, initialWeight η η₀ Q Φ Z z *
      ‖row false (primeEnclosure Z) (naturalCharacter η z)
        (fun q : {q : {q // singletonBlock r q} // q ∉ A} =>
          initialPool rayM H w Z (singletonRepresentative r q.val))
        (crossBeta A (primeEnclosure Z) ti
          (RestorationCollisionEnergy.collisionBeta r (primeEnclosure Z) tc
            (initialCoefficient rayM H hH η₀ θ W w σ v Z t)))
        (fun q => Z^(w (singletonRepresentative r q.val)))
        (raisedProfile p t 0) (raisedProfile p t 1) (9/4) Y₁ Y₂‖^2) ≤
      C*diagonalControl Φ*(p.control controls)^2*
        (1+|t|+height)^degree*Z^(1+ε)

theorem restricted_mono_mesh (face : SourceFace) (W : ℝ → ℂ)
    (bΦ mesh mesh' ε Z : ℝ) (η η₀ : Character) (Q : Id)
    (degree : ℕ) (controls : Finset (ℕ×ℕ)) (C : ℝ)
    (hm : mesh' ≤ mesh)
    (h : RestrictedInitialAt (α:=α) rayM H hH face W bΦ mesh ε Z
      η η₀ Q degree controls C) :
    RestrictedInitialAt (α:=α) rayM H hH face W bΦ mesh' ε Z
      η η₀ Q degree controls C := by
  intro T θ w σ v t height hw hwm
  exact h T θ w σ v t height hw (fun i => (hwm i).trans hm)

/-- Removing the unit puncture changes no ideal coefficient, including zero
ideals. This is used before taking norms, not as coefficientwise domination. -/
private theorem unit_polynomial (χ : Character) (W : ℝ → ℂ) (X : ℝ) :
    HeckeDyadic.polynomial (excluded χ 1) false W X 0 0 =
      HeckeDyadic.polynomial χ false W X 0 0 := by
  simp only [HeckeDyadic.polynomial,HeckeDyadic.summand,HeckeDyadic.coefficient,
    Bool.false_eq_true,ite_false,excluded_one_ideal]

private theorem unit_slot (χ : Character) (pool : Finset Id) (β : Id → ℂ) (P : ℝ) :
    naturalSlot (excluded χ 1) pool β P = naturalSlot χ pool β P := by
  simp only [naturalSlot,excluded_one_ideal]

/-- Literal full-row normalization at every retained physical row. Both
ordinary heights contribute only their original unit phases; all marked
heights remain in initialCoefficient. -/
theorem full_row_norm {ι : Type*} [Fintype ι] [DecidableEq ι]
    (η : Character) (z : O) (hz : z ≠ 0) (S : Finset PrimeIdeal)
    (pool : ι → Finset Id) (β : ι → Id → ℂ) (P : ι → ℝ) (hP : ∀ i, 0 < P i)
    (p : Profiles (1/4) (9/4)) (t X₁ X₂ : ℝ)
    (hX₁ : 0 < X₁) (hX₂ : 0 < X₂)
    (henclose : ∀ I, Supported I →
      ((Ideal.absNorm I : ℝ) ≤ (9/4)*X₁ ∨ (Ideal.absNorm I : ℝ) ≤ (9/4)*X₂) →
      QRH.Record1252270103KernelMass.primeSupport I ⊆ primeValues S) :
    ‖fullRow S (naturalCharacter η z) (fun i => supportedPool (pool i))
      (fun i => heightCoefficient (β i) t) P
      (raisedProfile p t 0) (raisedProfile p t 1) (9/4) X₁ X₂‖ =
    ‖positiveSlotRow η (fixedBadMask*idealGenerator 1) 1 z
      (p.profile 0) (p.profile 1) pool β P t X₁ X₂‖ := by
  have hχ := natural_character_off_supported η z hz
  have hs (i : Fin 2) : Function.support (raisedProfile p t i : ℝ → ℂ) ⊆ Set.Iic (9/4:ℝ) :=
    (CenteredMomentTwist.normPowerProfile_support _ _ _ _ _ _ _).trans
      (fun x hx => (p.support i hx).2)
  have he := original_positive_normalized (naturalRow η z hz) 1 one_ne_zero
    (p.profile 0) (p.profile 1) (1/4) (9/4) (1/4) (9/4)
    (by norm_num) (by norm_num) (p.support 0) (p.support 1)
    ((p.profile 0).smooth ⊤) ((p.profile 1).smooth ⊤)
    pool β P hP t X₁ X₂ hX₁ hX₂
  simp only [unit_polynomial,unit_slot] at he
  rw [he,norm_mul,norm_mul,positive_height_phase_norm X₁ t hX₁,
    positive_height_phase_norm X₂ t hX₂,one_mul,one_mul]
  unfold fullRow
  rw [enclosed_row _ S (9/4) X₁ X₂ _ _ _ hχ henclose,
    natural_pair_row _ _ _ (9/4) X₁ X₂ hX₁ hX₂ (hs 0) (hs 1)]
  simp_rw [supported_naturalSlot _ hχ]
  rw [naturalCharacter_eq η z hz]
  rfl

private theorem length_one_cap (Z X : ℝ) (hZ : 1 < Z) (h : length Z X ≤ 1) : X ≤ Z := by
  calc
    X ≤ max 1 X := le_max_right _ _
    _ = Z^(length Z X) := by
      unfold length
      rw [Real.rpow_logb (zero_lt_one.trans hZ) (ne_of_gt hZ)
        (lt_of_lt_of_le zero_lt_one (le_max_left _ _))]
    _ ≤ Z^((1:ℝ)) := Real.rpow_le_rpow_of_exponent_le hZ.le h
    _ = Z := Real.rpow_one _

/-- Restoration at the literal initial-energy interface. The
restoration constant is chosen uniformly over all subsets of the ambient
type before the scale and all physical/source data. -/
theorem initial_from_restricted (face : SourceFace) (hface : face.plainHi ≤ 1)
    (W : ℝ → ℂ) (hW : ContDiff ℝ ∞ W)
    (hWs : Function.support W ⊆ Set.Icc (1:ℝ) 2) (ε : ℝ) (hε : 0 < ε) :
    ∃ D : ℝ, 0 < D ∧ ∀ bΦ mesh Z : ℝ, mesh ≤ 1 → 1 < Z →
    ∀ (η η₀ : Character) (Q : Id) (degree : ℕ) (controls : Finset (ℕ×ℕ)) (C : ℝ),
      0 < C →
      RestrictedInitialAt (α:=α) rayM H hH face W bΦ mesh (ε/2) Z
        η η₀ Q degree controls C →
      InitialAffineAt (α:=α) rayM H hH face W 2 (1/4) (9/4) bΦ mesh
        (33/50) (33/50) 1 1 ε Z η η₀ Q degree controls (D*C) := by
  obtain ⟨B₀,hB₀,hcoeff⟩ := slot_coefficient_bounds W 1 2 (33/50) (33/50)
    (by norm_num) hWs hW.continuous
  let B := max 1 B₀
  have hB : 1 ≤ B := le_max_left _ _
  choose D₀ hD₀ hrestore using fun T : Finset α =>
    RestorationComplete.full_energy_exact (α:=T) B (ε/4) hB (by positivity)
  let D₁ : ℝ := 1+∑ T : Finset α, D₀ T
  have hD₁ : 0 < D₁ := by
    have hn := Finset.sum_nonneg (fun T (_ : T ∈ (Finset.univ : Finset (Finset α))) => (hD₀ T).le)
    dsimp only [D₁]; linarith
  have hDle (T : Finset α) : D₀ T ≤ D₁ := by
    have hh := Finset.single_le_sum (s:=Finset.univ) (f:=D₀)
      (fun T _ => (hD₀ T).le) (Finset.mem_univ T)
    dsimp only [D₁]; linarith
  refine ⟨D₁*4^(ε/4),mul_pos hD₁ (Real.rpow_pos_of_pos (by norm_num) _),?_⟩
  intro bΦ mesh Z hmesh hZ η η₀ Q degree controls C hC hE
  intro T θ w σ v t height hw hwm hσlo hσhi hheight hv M hMlo hMhi
    Φ hΦ hΦpos p X₁ X₂ hX₁ hX₂ hadm
  have hM : M=1 := le_antisymm hMhi hMlo
  subst M
  have hZ0 : 0 < Z := zero_lt_one.trans hZ
  have hcap₁ : X₁ ≤ Z := length_one_cap Z X₁ hZ (by
    have hh : length Z X₁ ≤ face.plainHi := by simpa only [mul_one] using hadm.2.1
    exact hh.trans hface)
  have hcap₂ : X₂ ≤ Z := length_one_cap Z X₂ hZ (by
    have hh : length Z X₂ ≤ face.plainHi := by simpa only [mul_one] using hadm.2.2.2.1
    exact hh.trans hface)
  let pool := initialPool rayM H w Z
  let β := initialCoefficient rayM H hH η₀ θ W w σ v Z t
  let P := fun i : T => Z^(w i)
  let X := 4*Z^(2:ℝ)
  let ρ := initialWeight η η₀ Q Φ Z
  let E := C*diagonalControl Φ*(p.control controls)^2*
    (1+|t|+height)^degree*Z^(1+ε/2)
  have hP (i : T) : 0 < P i := Real.rpow_pos_of_pos hZ0 _
  have hX : 1 ≤ X := one_le_mul_of_one_le_of_one_le (by norm_num)
    (Real.one_le_rpow hZ.le (by norm_num))
  have hpool (i : T) : pool i ⊆ primeValues (primeEnclosure Z) := by
    rw [primeEnclosure,enclosure_values]
    exact canonical_pool_enclosed rayM H Z (w i) 2 4 hZ.le
      ((hwm i).trans (hmesh.trans (by norm_num))) (by norm_num)
  have hp (i : T) (I : Id) (hi : I ∈ pool i) :
      Supported I ∧ (I.absNorm:ℝ) ≤ 2*P i :=
    ⟨(Finset.mem_filter.mp hi).2,
      canonical_pool_norm_le rayM H _ (hP i) I (Finset.mem_filter.mp hi).1⟩
  have hβ (i : T) (I : Id) (hi : I ∈ pool i) : ‖β i I‖ ≤ B :=
    ((hcoeff (relativeCharacter rayM H hH η₀ (θ i)) (P i) (σ i) (v i) t
      (hP i) (hσlo i) (hσhi i) I (hp i I hi).1.1).1).trans (le_max_right _ _)
  have hρ (z : O) : 0 ≤ ρ z := by
    dsimp only [ρ,initialWeight]
    split_ifs
    · exact hΦpos _
    · exact le_rfl
  have hdiag := diagonalControl_nonneg Φ
  have hE0 : 0 ≤ E := by dsimp only [E]; positivity
  have hfinite (rows : Finset O) :
      (∑ z ∈ rows, ρ z*‖fullRow (primeEnclosure Z) (naturalCharacter η z)
        pool β P (raisedProfile p t 0) (raisedProfile p t 1) (9/4) X₁ X₂‖^2) ≤
      D₀ T*X^(ε/4)*E := by
    apply hrestore T X hX (primeEnclosure Z)
      (fun Q hQ => enclosure_bound X Q hQ) rows ρ (naturalCharacter η)
      pool β P hpool hP hp hβ
      (raisedProfile p t 0) (raisedProfile p t 1) (9/4) X₁ X₂ E
      hX₁ hX₂ hE0 (fun z _ => hρ z)
    intro r tc A ti hti Y₁ Y₂ hY₁ hc₁ hY₂ hc₂
    exact hE T θ w σ v t height hw hwm hσlo hσhi hheight hv Φ hΦ hΦpos
      p X₁ X₂ hX₁ hX₂ hadm rows r tc A ti hti Y₁ Y₂ hY₁ hc₁ hY₂ hc₂
  have hseries := RestorationComplete.full_series ρ (naturalCharacter η) (primeEnclosure Z)
    pool β P (raisedProfile p t 0) (raisedProfile p t 1) (9/4) X₁ X₂
    (D₀ T*X^(ε/4)*E) hρ hfinite
  have hgeom : ∀ I, Supported I →
      ((I.absNorm:ℝ) ≤ (9/4)*X₁ ∨ (I.absNorm:ℝ) ≤ (9/4)*X₂) →
      QRH.Record1252270103KernelMass.primeSupport I ⊆ primeValues (primeEnclosure Z) := by
    intro I hI hi
    apply support_enclosed X I hI
    have hzpow : Z ≤ Z^(2:ℝ) := by
      calc
        Z = Z^(1:ℝ) := (Real.rpow_one _).symm
        _ ≤ _ := Real.rpow_le_rpow_of_exponent_le hZ.le (by norm_num)
    have hc₁ : (9/4)*X₁ ≤ X := by dsimp only [X]; nlinarith
    have hc₂ : (9/4)*X₂ ≤ X := by dsimp only [X]; nlinarith
    exact hi.elim (fun h => h.trans hc₁) (fun h => h.trans hc₂)
  have hid : energy η (fixedBadMask*idealGenerator 1) 1 t (p.profile 0) (p.profile 1)
      (fun i : T => CenteredMomentPrimeSlot.primePool rayM H 2 (P i))
      (rawCoefficient rayM H hH η₀ θ W w σ v Z) P X₁ X₂
      (initialKeep η (internalQ Q η₀)) Φ Z =
      ∑' z, ρ z*‖fullRow (primeEnclosure Z) (naturalCharacter η z) pool β P
        (raisedProfile p t 0) (raisedProfile p t 1) (9/4) X₁ X₂‖^2 := by
    unfold energy
    apply tsum_congr
    intro z
    by_cases hk : initialKeep η (internalQ Q η₀) z
    · have he := full_row_norm η z hk.1 (primeEnclosure Z)
        (fun i : T => CenteredMomentPrimeSlot.primePool rayM H 2 (P i))
        (rawCoefficient rayM H hH η₀ θ W w σ v Z) P hP p t X₁ X₂ hX₁ hX₂ hgeom
      have hn : ‖fullRow (primeEnclosure Z) (naturalCharacter η z) pool β P
          (raisedProfile p t 0) (raisedProfile p t 1) (9/4) X₁ X₂‖ =
          ‖positiveSlotRow η (fixedBadMask*idealGenerator 1) 1 z
            (p.profile 0) (p.profile 1)
            (fun i : T => CenteredMomentPrimeSlot.primePool rayM H 2 (P i))
            (rawCoefficient rayM H hH η₀ θ W w σ v Z) P t X₁ X₂‖ := he
      simp only [ρ,initialWeight,hk,ite_true,hn]
      ring
    · simp only [hk,ite_false,ρ,initialWeight,zero_mul]
  simp only [Real.rpow_one]
  change energy η (fixedBadMask*idealGenerator 1) 1 t _ _ _ _ _ _ _ _ _ Z ≤ _
  refine hid.le.trans (hseries.2.trans ?_)
  have hpow : X^(ε/4)*Z^(1+ε/2) = 4^(ε/4)*Z^(1+ε) := by
    dsimp only [X]
    rw [Real.mul_rpow (by norm_num) (Real.rpow_nonneg hZ0.le _),
      ←Real.rpow_mul hZ0.le,mul_assoc,←Real.rpow_add hZ0]
    congr 2
    ring
  calc
    D₀ T*X^(ε/4)*E ≤ D₁*X^(ε/4)*E :=
      mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_right (hDle T) (Real.rpow_nonneg (zero_le_one.trans hX) _)) hE0
    _ = _ := by dsimp only [E]; rw [show D₁*X^(ε/4)*
        (C*diagonalControl Φ*(p.control controls)^2*(1+|t|+height)^degree*Z^(1+ε/2)) =
        (D₁*C*diagonalControl Φ*(p.control controls)^2*(1+|t|+height)^degree)*
          (X^(ε/4)*Z^(1+ε/2)) by ring,hpow]; ring

/-- Restricted-source estimate with a mesh chosen before the arbitrary
ambient finite type. Restoration converts this input to the full source. -/
def RestrictedUnitSource (face : SourceFace) (mesh ε : ℝ) : Prop :=
  ∀ (α : Type) [Fintype α] [DecidableEq α],
  ∀ (rayM : Id) [NeZero rayM] (H : Subgroup (O⧸rayM)ˣ)
    (hH : RayOrthogonality.globalUnits rayM ≤ H),
  ∀ (W : ℝ → ℂ), ContDiff ℝ ∞ W → Function.support W ⊆ Set.Icc (1:ℝ) 2 →
  ∀ bΦ : ℝ, 2 ≤ bΦ → ∀ (η η₀ : Character) (Q : Id),
    Q ≤ rayM → internalQ Q η₀ ≠ 0 → internalQ Q η₀ ≠ ⊤ →
    internalQ Q η₀ ≤ Ideal.span {(72:O)} →
    ∃ degree : ℕ, ∃ controls : Finset (ℕ×ℕ), ∃ C : ℝ, 0 < C ∧
      ∀ᶠ Z : ℝ in atTop,
        RestrictedInitialAt (α:=α) rayM H hH face W bΦ mesh ε Z
          η η₀ Q degree controls C

def UniformRestrictedUnitSource (face : SourceFace) : Prop :=
  ∀ ε : ℝ, 0 < ε → ∃ mesh : ℝ, 0 < mesh ∧ RestrictedUnitSource face mesh ε

/-- Complete F adapter. The restricted E statement is the sole premise;
all restoration, natural-product normalization and uniformity are supplied
by the proof. In particular this theorem is not an unconditional source. -/
theorem uniform_source_of_restricted (face : SourceFace) (hface : face.plainHi ≤ 1)
    (hrestricted : UniformRestrictedUnitSource face) : UniformUnitFaceSource face := by
  intro ε hε
  obtain ⟨mesh,hmesh,hsource⟩ := hrestricted (ε/2) (half_pos hε)
  refine ⟨min mesh 1,lt_min hmesh zero_lt_one,?_⟩
  intro α _ _ rayM _ H hH W hW hWs bΦ hbΦ η η₀ Q hQray hQ0 hQt hQ72
  obtain ⟨degree,controls,C,hC,hbound⟩ :=
    hsource α rayM H hH W hW hWs bΦ hbΦ η η₀ Q hQray hQ0 hQt hQ72
  obtain ⟨D,hD,hrestore⟩ := initial_from_restricted (α:=α) rayM H hH face hface W hW hWs ε hε
  refine ⟨degree,controls,D*C,mul_pos hD hC,?_⟩
  filter_upwards [hbound,eventually_gt_atTop (1:ℝ)] with Z hZ hZ1
  exact hrestore bΦ (min mesh 1) Z (min_le_right _ _) hZ1 η η₀ Q degree controls C hC
    (restricted_mono_mesh (α:=α) rayM H hH face W bΦ mesh (min mesh 1)
      (ε/2) Z η η₀ Q degree controls C (min_le_left _ _) hZ)

/-- Exact full source face consumed by the return argument. -/
theorem global_source_of_restricted
    (hrestricted : UniformRestrictedUnitSource
      (QRH.Record1252270103Source.globalFace (99999/100000) (93/25) (3/50))) :
    QRH.Record1252270103Source.GlobalSource (99999/100000) (93/25) (3/50) := by
  exact uniform_source_of_restricted _ (by norm_num [QRH.Record1252270103Source.globalFace]) hrestricted

