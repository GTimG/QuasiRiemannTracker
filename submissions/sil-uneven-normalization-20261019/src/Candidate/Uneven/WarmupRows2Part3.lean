theorem gap_2_36 {d p : ℝ}
    (hd : (15/32:ℝ) ≤ d ∧ d ≤ (123/256:ℝ))
    (hp : (0/1:ℝ) ≤ p ∧ p ≤ (63/128:ℝ)) :
    0 ≤ gap 2 0 d p := by
  let bx : ℝ := (d-(15/32:ℝ))/(3/256:ℝ)
  let byv : ℝ := (p-(0/1:ℝ))/(63/128:ℝ)
  have hx : 0 ≤ bx := by dsimp [bx]; linarith only [hd.1]
  have hx' : 0 ≤ 1-bx := by dsimp [bx]; linarith only [hd.2]
  have hy : 0 ≤ byv := by dsimp [byv]; linarith only [hp.1]
  have hy' : 0 ≤ 1-byv := by dsimp [byv]; linarith only [hp.2]
  have hid : gap 2 0 d p =
    (2803991/64000000:ℝ)*bx^0*(1-bx)^2*byv^0*(1-byv)^3 +
    (1396902006819313951/23121059299328000000:ℝ)*bx^0*(1-bx)^2*byv^1*(1-byv)^2 +
    (124208757229487170211/5918991180627968000000:ℝ)*bx^0*(1-bx)^2*byv^2*(1-byv)^1 +
    (19723517729357968163/23675964722511872000000:ℝ)*bx^0*(1-bx)^2*byv^3*(1-byv)^0 +
    (229921609/2560000000:ℝ)*bx^1*(1-bx)^1*byv^0*(1-byv)^3 +
    (28659884859504324443/231210592993280000000:ℝ)*bx^1*(1-bx)^1*byv^1*(1-byv)^2 +
    (1020626814862311545191/23675964722511872000000:ℝ)*bx^1*(1-bx)^1*byv^2*(1-byv)^1 +
    (802008373765479333947/473519294450237440000000:ℝ)*bx^1*(1-bx)^1*byv^3*(1-byv)^0 +
    (471751001/10240000000:ℝ)*bx^2*(1-bx)^0*byv^0*(1-byv)^3 +
    (94245699010268250853/1479747795156992000000:ℝ)*bx^2*(1-bx)^0*byv^1*(1-byv)^2 +
