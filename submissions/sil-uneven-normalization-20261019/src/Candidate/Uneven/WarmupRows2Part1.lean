theorem gap_2_12 {d p : ℝ}
    (hd : (459/1024:ℝ) ≤ d ∧ d ≤ (231/512:ℝ))
    (hp : (0/1:ℝ) ≤ p ∧ p ≤ (63/128:ℝ)) :
    0 ≤ gap 2 0 d p := by
  let bx : ℝ := (d-(459/1024:ℝ))/(3/1024:ℝ)
  let byv : ℝ := (p-(0/1:ℝ))/(63/128:ℝ)
  have hx : 0 ≤ bx := by dsimp [bx]; linarith only [hd.1]
  have hx' : 0 ≤ 1-bx := by dsimp [bx]; linarith only [hd.2]
  have hy : 0 ≤ byv := by dsimp [byv]; linarith only [hp.1]
  have hy' : 0 ≤ 1-byv := by dsimp [byv]; linarith only [hp.2]
  have hid : gap 2 0 d p =
    (6585209237/163840000000:ℝ)*bx^0*(1-bx)^2*byv^0*(1-byv)^3 +
    (6560285667740902214153/118379823612559360000000:ℝ)*bx^0*(1-bx)^2*byv^1*(1-byv)^2 +
    (586121333828029029823783/30305234844815196160000000:ℝ)*bx^0*(1-bx)^2*byv^2*(1-byv)^1 +
