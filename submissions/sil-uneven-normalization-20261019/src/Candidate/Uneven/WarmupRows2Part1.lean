    (3312552997/40960000000:ℝ)*bx^1*(1-bx)^1*byv^0*(1-byv)^3 +
    (3299318988957386883181/29594955903139840000000:ℝ)*bx^1*(1-bx)^1*byv^1*(1-byv)^2 +
    (294463233722397471778547/7576308711203799040000000:ℝ)*bx^1*(1-bx)^1*byv^2*(1-byv)^1 +
    (52339319621044346373731/30305234844815196160000000:ℝ)*bx^1*(1-bx)^1*byv^3*(1-byv)^0 +
    (1666426469/40960000000:ℝ)*bx^2*(1-bx)^0*byv^0*(1-byv)^3 +
