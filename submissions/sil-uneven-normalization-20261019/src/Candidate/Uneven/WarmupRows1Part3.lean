theorem gap_1_36 {d p : ℝ}
    (hd : (15/32:ℝ) ≤ d ∧ d ≤ (123/256:ℝ))
    (hp : (0/1:ℝ) ≤ p ∧ p ≤ (63/128:ℝ)) :
    0 ≤ gap 1 0 d p := by
  let bx : ℝ := (d-(15/32:ℝ))/(3/256:ℝ)
  let byv : ℝ := (p-(0/1:ℝ))/(63/128:ℝ)
  have hx : 0 ≤ bx := by dsimp [bx]; linarith only [hd.1]
  have hx' : 0 ≤ 1-bx := by dsimp [bx]; linarith only [hd.2]
  have hy : 0 ≤ byv := by dsimp [byv]; linarith only [hp.1]
  have hy' : 0 ≤ 1-byv := by dsimp [byv]; linarith only [hp.2]
  have hid : gap 1 0 d p =
    (2803991/64000000:ℝ)*bx^0*(1-bx)^2*byv^0*(1-byv)^3 +
    (36889855564349/614121472000000:ℝ)*bx^0*(1-bx)^2*byv^1*(1-byv)^2 +
    (120578857333855327837/5892893474553856000000:ℝ)*bx^0*(1-bx)^2*byv^2*(1-byv)^1 +
    (15092704336844741821/23571573898215424000000:ℝ)*bx^0*(1-bx)^2*byv^3*(1-byv)^0 +
    (229921609/2560000000:ℝ)*bx^1*(1-bx)^1*byv^0*(1-byv)^3 +
    (378464538409241/3070607360000000:ℝ)*bx^1*(1-bx)^1*byv^1*(1-byv)^2 +
    (991278325416835779737/23571573898215424000000:ℝ)*bx^1*(1-bx)^1*byv^2*(1-byv)^1 +
    (615653187690140675749/471431477964308480000000:ℝ)*bx^1*(1-bx)^1*byv^3*(1-byv)^0 +
    (471751001/10240000000:ℝ)*bx^2*(1-bx)^0*byv^0*(1-byv)^3 +
    (2489351364174419/39303774208000000:ℝ)*bx^2*(1-bx)^0*byv^1*(1-byv)^2 +
    (40931738516803389680249/1885725911857233920000000:ℝ)*bx^2*(1-bx)^0*byv^2*(1-byv)^1 +
    (5237699794706384355113/7542903647428935680000000:ℝ)*bx^2*(1-bx)^0*byv^3*(1-byv)^0 := by
