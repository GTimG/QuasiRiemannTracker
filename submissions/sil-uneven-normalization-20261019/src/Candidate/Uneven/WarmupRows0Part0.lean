theorem gap_0_0 {d p : ℝ}
    (hd : (0/1:ℝ) ≤ d ∧ d ≤ (111/256:ℝ))
    (hp : (0/1:ℝ) ≤ p ∧ p ≤ (63/128:ℝ)) :
    0 ≤ gap 0 0 d p := by
  let bx : ℝ := (d-(0/1:ℝ))/(111/256:ℝ)
  let byv : ℝ := (p-(0/1:ℝ))/(63/128:ℝ)
  have hx : 0 ≤ bx := by dsimp [bx]; linarith only [hd.1]
  have hx' : 0 ≤ 1-bx := by dsimp [bx]; linarith only [hd.2]
  have hy : 0 ≤ byv := by dsimp [byv]; linarith only [hp.1]
  have hy' : 0 ≤ 1-byv := by dsimp [byv]; linarith only [hp.2]
  have hid : gap 0 0 d p =
    (5482253/4000000:ℝ)*bx^0*(1-bx)^2*byv^0*(1-byv)^3 +
    (70755760879237/19191296000000:ℝ)*bx^0*(1-bx)^2*byv^1*(1-byv)^2 +
    (31301433353029/9595648000000:ℝ)*bx^0*(1-bx)^2*byv^2*(1-byv)^1 +
    (18149990844293/19191296000000:ℝ)*bx^0*(1-bx)^2*byv^3*(1-byv)^0 +
    (5028191257/2560000000:ℝ)*bx^1*(1-bx)^1*byv^0*(1-byv)^3 +
    (61467182228106917/12282429440000000:ℝ)*bx^1*(1-bx)^1*byv^1*(1-byv)^2 +
    (2472184685873041817441/589289347455385600000:ℝ)*bx^1*(1-bx)^1*byv^2*(1-byv)^1 +
    (17013564986620509725081/14732233686384640000000:ℝ)*bx^1*(1-bx)^1*byv^3*(1-byv)^0 +
    (7040775473/10240000000:ℝ)*bx^2*(1-bx)^0*byv^0*(1-byv)^3 +
    (326313930938810161/196518871040000000:ℝ)*bx^2*(1-bx)^0*byv^1*(1-byv)^2 +
    (2497522334640398774107241/1885725911857233920000000:ℝ)*bx^2*(1-bx)^0*byv^2*(1-byv)^1 +
    (2626552342138064001611513/7542903647428935680000000:ℝ)*bx^2*(1-bx)^0*byv^3*(1-byv)^0 := by
    dsimp [gap,base,denominator,numerator,theta,reserve,h,y,ell,
