theorem gap_2_0 {d p : ℝ}
    (hd : (0/1:ℝ) ≤ d ∧ d ≤ (111/256:ℝ))
    (hp : (0/1:ℝ) ≤ p ∧ p ≤ (63/128:ℝ)) :
    0 ≤ gap 2 0 d p := by
  let bx : ℝ := (d-(0/1:ℝ))/(111/256:ℝ)
  let byv : ℝ := (p-(0/1:ℝ))/(63/128:ℝ)
  have hx : 0 ≤ bx := by dsimp [bx]; linarith only [hd.1]
  have hx' : 0 ≤ 1-bx := by dsimp [bx]; linarith only [hd.2]
  have hy : 0 ≤ byv := by dsimp [byv]; linarith only [hp.1]
  have hy' : 0 ≤ 1-byv := by dsimp [byv]; linarith only [hp.2]
  have hid : gap 2 0 d p =
    (264557/4000000:ℝ)*bx^0*(1-bx)^2*byv^0*(1-byv)^3 +
    (3414459681253/19191296000000:ℝ)*bx^0*(1-bx)^2*byv^1*(1-byv)^2 +
    (1510512795301/9595648000000:ℝ)*bx^0*(1-bx)^2*byv^2*(1-byv)^1 +
    (875863833317/19191296000000:ℝ)*bx^0*(1-bx)^2*byv^3*(1-byv)^0 +
    (25606633/2560000000:ℝ)*bx^1*(1-bx)^1*byv^0*(1-byv)^3 +
    (10609760025370697797/462421185986560000000:ℝ)*bx^1*(1-bx)^1*byv^1*(1-byv)^2 +
    (12019818079577425639/591899118062796800000:ℝ)*bx^1*(1-bx)^1*byv^2*(1-byv)^1 +
    (108996251189855622127/14797477951569920000000:ℝ)*bx^1*(1-bx)^1*byv^3*(1-byv)^0 +
    (387738737/10240000000:ℝ)*bx^2*(1-bx)^0*byv^0*(1-byv)^3 +
    (387798944327298131393/7398738975784960000000:ℝ)*bx^2*(1-bx)^0*byv^1*(1-byv)^2 +
    (35215970279545519090303/1894077177800949760000000:ℝ)*bx^2*(1-bx)^0*byv^2*(1-byv)^1 +
    (7640787116811421036207/7576308711203799040000000:ℝ)*bx^2*(1-bx)^0*byv^3*(1-byv)^0 := by
    dsimp [gap,base,denominator,numerator,theta,reserve,h,y,ell,
      rowHeight,rowCapacity,planeB,planeLambda,bx,byv]
    norm_num
    ring
  rw [hid]
