theorem gap_1_12 {d p : ℝ}
    (hd : (459/1024:ℝ) ≤ d ∧ d ≤ (231/512:ℝ))
    (hp : (0/1:ℝ) ≤ p ∧ p ≤ (63/128:ℝ)) :
    0 ≤ gap 1 0 d p := by
  let bx : ℝ := (d-(459/1024:ℝ))/(3/1024:ℝ)
  let byv : ℝ := (p-(0/1:ℝ))/(63/128:ℝ)
  have hx : 0 ≤ bx := by dsimp [bx]; linarith only [hd.1]
  have hx' : 0 ≤ 1-bx := by dsimp [bx]; linarith only [hd.2]
  have hy : 0 ≤ byv := by dsimp [byv]; linarith only [hp.1]
  have hy' : 0 ≤ 1-byv := by dsimp [byv]; linarith only [hp.2]
  have hid : gap 1 0 d p =
    (6585209237/163840000000:ℝ)*bx^0*(1-bx)^2*byv^0*(1-byv)^3 +
    (173193046393586287/3144301936640000000:ℝ)*bx^0*(1-bx)^2*byv^1*(1-byv)^2 +
    (568194058722535985000921/30171614589715742720000000:ℝ)*bx^0*(1-bx)^2*byv^2*(1-byv)^1 +
    (82552074628987924186889/120686458358862970880000000:ℝ)*bx^0*(1-bx)^2*byv^3*(1-byv)^0 +
    (3312552997/40960000000:ℝ)*bx^1*(1-bx)^1*byv^0*(1-byv)^3 +
    (87104515592347979/786075484160000000:ℝ)*bx^1*(1-bx)^1*byv^1*(1-byv)^2 +
    (285477352794931632331789/7542903647428935680000000:ℝ)*bx^1*(1-bx)^1*byv^2*(1-byv)^1 +
    (40707957913864999899517/30171614589715742720000000:ℝ)*bx^1*(1-bx)^1*byv^3*(1-byv)^0 +
    (1666426469/40960000000:ℝ)*bx^2*(1-bx)^0*byv^0*(1-byv)^3 +
