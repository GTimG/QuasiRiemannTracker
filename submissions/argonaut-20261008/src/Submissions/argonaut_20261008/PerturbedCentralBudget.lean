import Submissions.argonaut_20261008.PerturbedBudgetWithSlots
import Submissions.argonaut_20261008.PerturbedCentralExponent

namespace OAI.SevenEighths.PerturbedCentral
noncomputable section

open OAI.SevenEighths.CentralPerturbation

/--
The exact scalar budget needed by `adaptive_mixed_saving_gap`, with
`εm = slotMesh = ν = ζ = loss = saving = t`, `μ = 2t`, and
`overhead = t+t+t`.  The slot contribution is the actual `totalE*t`.
-/
theorem exists_actual_central_physical_budget (β : ℝ)
    (hβ : boundary < β) :
    ∃ t : ℝ, 0 < t ∧ t < deltaGap β / 4 ∧ t ≤ 1 / 100000000 ∧
      ∀ N : ℕ, ∃ allowance : ℝ, 0 < allowance ∧
        ∀ ε e eps : ℝ,
          0 ≤ ε → ε ≤ allowance → 0 ≤ e → e ≤ allowance →
          0 ≤ eps → eps ≤ allowance →
          159 * ε + t + t + 7 * t ≤ 1 / 32 ∧
          physicalHeight * (159 * ε + t + t + 7 * t) +
            2 * t + (3 / 2) * (2 * t) +
            (26 * e + (N + 8) * eps + t + totalE * t) +
            (t + t + t) + t + 15 * rho0 / 8 < 49 / 440640 := by
  have hΔ : 0 < deltaGap β := deltaGap_pos hβ
  obtain ⟨t, ht, htΔ, htcap, hallow⟩ :=
    exists_perturbed_central_budget_with_slots
      (deltaGap β) (49 / 440640) physicalHeight totalE
      hΔ (by norm_num) height_nonneg height_le_one totalE_pos.le totalE_le_one
  refine ⟨t, ht, htΔ, htcap, ?_⟩
  intro N
  obtain ⟨allowance, ha, hbudget⟩ := hallow N
  refine ⟨allowance, ha, ?_⟩
  intro ε e eps hε hεa he hea heps hepsa
  obtain ⟨hcount, hcost⟩ := hbudget ε e eps hε hεa he hea heps hepsa
  refine ⟨hcount, ?_⟩
  have hρ : 15 * rho0 / 8 < (49 / 440640) / 2 := by
    norm_num [rho0]
  linarith

/-- Non-strict form matching the assembly theorem's `hfinal` hypothesis. -/
theorem actual_central_physical_budget_to_hfinal
    (N : ℕ) (t ε e eps : ℝ)
    (h : physicalHeight * (159 * ε + t + t + 7 * t) +
      2 * t + (3 / 2) * (2 * t) +
      (26 * e + (N + 8) * eps + t + totalE * t) +
      (t + t + t) + t + 15 * rho0 / 8 < 49 / 440640) :
    physicalHeight * (159 * ε + t + t + 7 * t) +
      2 * t + (3 / 2) * (2 * t) +
      (26 * e + (N + 8) * eps + t + totalE * t) +
      (t + t + t) + t + 15 * rho0 / 8 ≤ 49 / 440640 := h.le

/-- Scalar side conditions needed when the common tiny parameter is used as `ζ`. -/
theorem tiny_mesh_scalar_ranges
    (t : ℝ) (ht : 0 ≤ t) (htcap : t ≤ 1 / 100000000) :
    t ≤ 3 / 16 ∧ physicalHeight + t ≤ 1 := by
  constructor
  · linarith
  · unfold physicalHeight rho0
    norm_num at *
    linarith

/-- The physical conductor-height placement generated by the same tiny mesh. -/
theorem fixed_height_plus_three_mesh_le_dmax
    (t : ℝ) (ht : 0 ≤ t) (htcap : t ≤ 1 / 100000000) :
    physicalHeight + t + 2 * t ≤ physicalDmax := by
  unfold physicalHeight physicalDmax rho0
  norm_num at *
  linarith

end
end OAI.SevenEighths.PerturbedCentral
