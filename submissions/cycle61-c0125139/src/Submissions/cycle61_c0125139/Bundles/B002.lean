  have hc' := hcount a ε (cutoff (2*a-1) (q/(2*a-1)) κplain) T allowance κplain ν C height q i
    hU ha hd hε hε' ht.1 ht.2 hk hk1 hν hC hh hf B hq hmom
  have he := max_at_cutoff hδ.le hd hx hx' hk hk1
  rw [he] at hc'
