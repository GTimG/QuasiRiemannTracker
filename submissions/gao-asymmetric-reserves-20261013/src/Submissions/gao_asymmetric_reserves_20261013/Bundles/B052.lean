    (hC : 0 ≤ C) (hR : ∀s : ℂ, a ≤ s.re → ‖HeckeReciprocal.reciprocal (η.excludePrimes S hS.prime) s‖ ≤ C*(1+|s.im|^2))
    (p : HeightSpace) :
