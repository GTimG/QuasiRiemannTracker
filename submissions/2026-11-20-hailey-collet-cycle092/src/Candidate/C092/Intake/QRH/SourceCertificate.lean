/-!
# All recovered finite source-certificate checks

The 3960 literal length cells and 31680 ordered response bins come from
`research/local_cycle088/near_record/SYMMETRIC_SOURCE.json` in the user-supplied
Cycle 092 packet. Its SHA256 is
`f3c99a957655f73c76dd50472887c821f529cf2be58125e976ada65d39062047`.

Every generated batch is checked by kernel reduction. This module assembles
those proofs, checks the complete closed real length coverage, and transfers
the high-response costs to every real length and response in each checked cell.
It does not assert the analytic source
admission theorem or the all-height physical endpoint.
-/

set_option autoImplicit false
set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace QRH.SourceCertificate

/-- The ordered 99 batches of literal recovered source cells. -/
def sourceBatches : List (List Cell) := [
  cells000, cells001, cells002, cells003, cells004,
  cells005, cells006, cells007, cells008, cells009,
  cells010, cells011, cells012, cells013, cells014,
  cells015, cells016, cells017, cells018, cells019,
  cells020, cells021, cells022, cells023, cells024,
  cells025, cells026, cells027, cells028, cells029,
  cells030, cells031, cells032, cells033, cells034,
  cells035, cells036, cells037, cells038, cells039,
  cells040, cells041, cells042, cells043, cells044,
  cells045, cells046, cells047, cells048, cells049,
  cells050, cells051, cells052, cells053, cells054,
  cells055, cells056, cells057, cells058, cells059,
  cells060, cells061, cells062, cells063, cells064,
  cells065, cells066, cells067, cells068, cells069,
  cells070, cells071, cells072, cells073, cells074,
  cells075, cells076, cells077, cells078, cells079,
  cells080, cells081, cells082, cells083, cells084,
  cells085, cells086, cells087, cells088, cells089,
  cells090, cells091, cells092, cells093, cells094,
  cells095, cells096, cells097, cells098
]

/-- Every batch is accepted, using its previously kernel-checked proof. -/
theorem sourceBatches_checked : sourceBatches.all cellsCheck = true := by
  simp only [sourceBatches, List.all_cons, List.all_nil,
    cells000_checked, cells001_checked, cells002_checked, cells003_checked,
    cells004_checked, cells005_checked, cells006_checked, cells007_checked,
    cells008_checked, cells009_checked, cells010_checked, cells011_checked,
    cells012_checked, cells013_checked, cells014_checked, cells015_checked,
    cells016_checked, cells017_checked, cells018_checked, cells019_checked,
    cells020_checked, cells021_checked, cells022_checked, cells023_checked,
    cells024_checked, cells025_checked, cells026_checked, cells027_checked,
    cells028_checked, cells029_checked, cells030_checked, cells031_checked,
    cells032_checked, cells033_checked, cells034_checked, cells035_checked,
    cells036_checked, cells037_checked, cells038_checked, cells039_checked,
    cells040_checked, cells041_checked, cells042_checked, cells043_checked,
    cells044_checked, cells045_checked, cells046_checked, cells047_checked,
    cells048_checked, cells049_checked, cells050_checked, cells051_checked,
    cells052_checked, cells053_checked, cells054_checked, cells055_checked,
    cells056_checked, cells057_checked, cells058_checked, cells059_checked,
    cells060_checked, cells061_checked, cells062_checked, cells063_checked,
    cells064_checked, cells065_checked, cells066_checked, cells067_checked,
    cells068_checked, cells069_checked, cells070_checked, cells071_checked,
    cells072_checked, cells073_checked, cells074_checked, cells075_checked,
    cells076_checked, cells077_checked, cells078_checked, cells079_checked,
    cells080_checked, cells081_checked, cells082_checked, cells083_checked,
    cells084_checked, cells085_checked, cells086_checked, cells087_checked,
    cells088_checked, cells089_checked, cells090_checked, cells091_checked,
    cells092_checked, cells093_checked, cells094_checked, cells095_checked,
    cells096_checked, cells097_checked, cells098_checked, Bool.and_self]

/-- All recorded length cells in their original order. -/
def sourceCells : List Cell := sourceBatches.flatten

/-- All actual source grid, support, root, low-cost, and high-cost finite tests pass. -/
theorem sourceCells_checked : cellsCheck sourceCells = true := by
  change sourceBatches.flatten.all cellCheck = true
  rw [List.all_flatten]
  exact sourceBatches_checked

/-- The kernel verifies the complete 3960-cell and 31680-bin inventory. -/
theorem sourceCells_counts : sourceCells.length = 3960 ∧
    (sourceCells.map (fun c => c.cutoffs.length)).sum = 31680 := by
  decide +kernel

/-- The actual cells join exactly from 0.369 to 0.3888 without a gap. -/
theorem sourceCells_chain : chainCheck ((369:ℚ)/1000) Y sourceCells = true := by
  decide +kernel

/-- The literal source certificate is nonempty. -/
theorem sourceCells_ne_nil : sourceCells ≠ [] := by
  intro h
  have hlen := sourceCells_counts.1
  simp only [h, List.length_nil] at hlen
  omega

/-- Every real source length lies in a literal cell whose complete finite tests pass. -/
theorem sourceCells_cover (y : ℝ) (hlower : (369:ℝ)/1000 ≤ y) (hupper : y ≤ (243:ℝ)/625) :
    ∃ c ∈ sourceCells, (c.lower : ℝ) ≤ y ∧ y ≤ (c.upper : ℝ) ∧ cellCheck c = true := by
  have h₀ : (((369:ℚ)/1000 : ℚ) : ℝ) ≤ y := by
    simpa only [Rat.cast_div, Rat.cast_ofNat] using hlower
  have h₁ : y ≤ (Y : ℝ) := by simpa only [Y, Rat.cast_div, Rat.cast_ofNat] using hupper
  obtain ⟨c, hc, hl, hu⟩ := chainCheck_closedCover sourceCells ((369:ℚ)/1000) Y
    sourceCells_chain sourceCells_ne_nil h₀ h₁
  exact ⟨c, hc, hl, hu, cellsCheck_sound sourceCells sourceCells_checked c hc⟩

/-- Each recorded cell has all three low samples and all literal high-bin endpoint costs paid. -/
theorem sourceCells_member_tests (c : Cell) (hc : c ∈ sourceCells) :
    LowPaid c.threshold c.lower ∧ LowPaid c.threshold c.upper ∧
    (c.lower < H*seam ∧ H*seam < c.upper → LowPaid c.threshold (H*seam)) ∧
    ∀ p ∈ c.cutoffs.zipIdx, CutoffGuard c.upper p.1 ∧
      EndpointPaid c.upper (c.threshold+(responseUpper-c.threshold)*(p.2:ℚ)/8) p.1 ∧
      EndpointPaid c.upper (c.threshold+(responseUpper-c.threshold)*(p.2+1:ℕ)/8) p.1 :=
  cellCheck_sound c (cellsCheck_sound sourceCells sourceCells_checked c hc)


/-- Each literal high-response bin pays every real response between its checked endpoints. -/
theorem sourceCells_member_real_paid (c : Cell) (hc : c ∈ sourceCells)
    (p : Cutoff × ℕ) (hp : p ∈ c.cutoffs.zipIdx) {e : ℝ}
    (h₀ : ((c.threshold+(responseUpper-c.threshold)*(p.2:ℚ)/8 : ℚ) : ℝ) ≤ e)
    (h₁ : e ≤ ((c.threshold+(responseUpper-c.threshold)*(p.2+1:ℕ)/8 : ℚ) : ℝ)) :
    CutoffGuard c.upper p.1 ∧ EndpointPaidReal c.upper e p.1 := by
  have htests := (sourceCells_member_tests c hc).2.2.2 p hp
  exact ⟨htests.1, endpointPaidReal_between c.upper p.1 h₀ h₁ htests.2.1 htests.2.2⟩


/-- Every recorded cell has a simultaneous cutoff paying every real high response at its upper endpoint. -/
theorem sourceCells_high_response (c : Cell) (hc : c ∈ sourceCells) {e : ℝ}
    (h₀ : (c.threshold : ℝ) ≤ e) (h₁ : e ≤ (responseUpper : ℝ)) :
    ∃ p ∈ c.cutoffs.zipIdx, CutoffGuard c.upper p.1 ∧ EndpointPaidReal c.upper e p.1 :=
  cellCheck_high_response c (cellsCheck_sound sourceCells sourceCells_checked c hc) h₀ h₁


/-- Every real source length and high response in a recorded cell has an actual paid simultaneous cutoff. -/
theorem sourceCells_real_length_response (c : Cell) (hc : c ∈ sourceCells) {y e : ℝ}
    (hyl : (c.lower : ℝ) ≤ y) (hyu : y ≤ (c.upper : ℝ))
    (hel : (c.threshold : ℝ) ≤ e) (heu : e ≤ (responseUpper : ℝ)) :
    ∃ p ∈ c.cutoffs.zipIdx, CutoffGuard c.upper p.1 ∧ PaidAt y e p.1 ∧
      2*y/(H : ℝ) ≤ (p.1.inverse : ℝ) ∧ y/(H : ℝ) ≤ (p.1.ordinary : ℝ) ∧
        y < (H : ℝ)*((p.1.inverse : ℝ)+(p.1.ordinary : ℝ))/2 :=
  cellCheck_real_length_response c (cellsCheck_sound sourceCells sourceCells_checked c hc)
    hyl hyu hel heu

/-- Every literal threshold is at least the exact reported least threshold. -/
theorem sourceCells_thresholds_checked :
    sourceCells.all (fun c => decide ((493719181:ℚ)/1250000000 ≤ c.threshold)) = true := by
  decide +kernel

/-- The least-threshold lower bound applies to every recorded cell. -/
theorem sourceCells_threshold_lower (c : Cell) (hc : c ∈ sourceCells) :
    (493719181:ℚ)/1250000000 ≤ c.threshold := by
  exact of_decide_eq_true ((List.all_eq_true.mp sourceCells_thresholds_checked) c hc)

end QRH.SourceCertificate
