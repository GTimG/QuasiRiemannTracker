set_option maxHeartbeats 0 in
 theorem stationaryPlans_checked : stationaryPlans.all planCheck = true := by
  decide +kernel


def stationaryRowCovered (r : QRH.Cycle092.TopData.Row) : Bool :=
  if r.event ∈ stationaryEvents then stationaryPlans.any (fun p => decide (p.row = r)) else true

set_option maxHeartbeats 0 in
 theorem actual_stationary_rows_covered : QRH.Cycle092.TopData.rows.all stationaryRowCovered = true := by
  decide +kernel

theorem stationaryPlans_length : stationaryPlans.length = 37 := by decide
 theorem stationaryPlans_segments : (stationaryPlans.map (fun p => p.segments.length)).sum = 102 := by decide

/-- The37 authentic stationary rows pay every real offset and every tested
ordinary length, from exact segment data rather than stored terminal values. -/
theorem actual_stationary_pays (r : QRH.Cycle092.TopData.Row)
    (hr : r ∈ QRH.Cycle092.TopData.rows) (hs : r.event ∈ stationaryEvents) {ξ z : ℝ}
    (hξ₀ : 0 ≤ ξ) (hξ₁ : ξ ≤ (rowGamma r.box r.B : ℝ))
    (hz₀ : widthLo ≤ z) (hz₁ : z ≤ widthHi) :
    (1/2000000000 : ℝ) ≤ actualWitnessPrice r.box r.B ξ z := by
  have hc := List.all_eq_true.mp actual_stationary_rows_covered r hr
  simp only [stationaryRowCovered,ite_eq_left hs,List.any_eq_true,decide_eq_true_eq] at hc
  obtain ⟨p,hp,he⟩ := hc
  subst r
  exact planCheck_sound p (List.all_eq_true.mp stationaryPlans_checked p hp) hξ₀ hξ₁ hz₀ hz₁

/-- Complete scalar mixed-price bridge for all9681 authentic Q terminals.
The only premises specify membership and the actual real offset/length domains;
no source monotonicity, derivative, minimum or positive-margin hypothesis remains. -/
theorem all_actual_mixed_rows_pays (r : QRH.Cycle092.TopData.Row)
    (hr : r ∈ QRH.Cycle092.TopData.rows) {ξ z : ℝ}
    (hξ₀ : 0 ≤ ξ) (hξ₁ : ξ ≤ (rowGamma r.box r.B : ℝ))
    (hz₀ : widthLo ≤ z) (hz₁ : z ≤ widthHi) :
    (1/2000000000 : ℝ) ≤ actualWitnessPrice r.box r.B ξ z := by
  by_cases hs : r.event ∈ stationaryEvents
  · exact actual_stationary_pays r hr hs hξ₀ hξ₁ hz₀ hz₁
  · exact actual_nonstationary_pays r hr hs hξ₀ hξ₁ hz₀ hz₁

set_option maxHeartbeats 0 in
 theorem all_actual_mixed_rows_count : QRH.Cycle092.TopData.rows.length = 9681 := by
  decide +kernel

end
end QRH.Cycle092.Mixed
