/-- Inputs retained by an actual four-edge physical history. The fields are
real coordinates, not free extra count labels. The native history producer
must construct them and prove the literal selected-row inequalities. -/
structure HistoryCoordinates where
  rootSlot : ℝ
  multiplierIncrement : Fin 4 → ℝ
  retainedReduction : Fin 4 → ℝ
  slotLoss : Fin 4 → ℝ
  rootCellSlack : ℝ

def HistoryCoordinates.vector (h : HistoryCoordinates) : Fin 14 → ℝ :=
  ![h.rootSlot,
    h.multiplierIncrement 0, h.multiplierIncrement 1,
    h.multiplierIncrement 2, h.multiplierIncrement 3,
    h.retainedReduction 0, h.retainedReduction 1,
    h.retainedReduction 2, h.retainedReduction 3,
    h.slotLoss 0, h.slotLoss 1, h.slotLoss 2, h.slotLoss 3,
    h.rootCellSlack]

theorem HistoryCoordinates.rootSlot_eq (h : HistoryCoordinates) :
    Coordinates.b h.vector = h.rootSlot := rfl

theorem HistoryCoordinates.rootCellSlack_eq (h : HistoryCoordinates) :
    Coordinates.rootSlack h.vector = h.rootCellSlack := rfl

/-- The complete fixed five-stage affine dual consumer in named physical
coordinates. Only the selected prefix rows are required. Turning native
histories into these coordinates is a separate analytic obligation. -/
theorem robust_for_physical_coordinates (i : Fin 62) (x : Fin 14 → ℝ) (E : ℝ)
    (hE : E ≤ 1 / 1000000000000000)
    (hc : ∀ j, -E ≤ Coordinates.rows ((gates i).selected j) x) :
    (1568511 / 1000000000000000 : ℝ) < Coordinates.objectives i x := by
  rw [← objective_meaning i x]
  apply robust_for_gate i x E hE
  intro j
  rw [constraint_meaning]
  exact hc j

theorem positive_for_physical_coordinates (i : Fin 62) (x : Fin 14 → ℝ) (E : ℝ)
    (hE : E ≤ 1 / 1000000000000000)
    (hc : ∀ j, -E ≤ Coordinates.rows ((gates i).selected j) x) :
    0 < Coordinates.objectives i x :=
  lt_trans (by norm_num) (robust_for_physical_coordinates i x E hE hc)

/-- Convenient application to a retained actual-history coordinate record. -/
theorem HistoryCoordinates.robust (h : HistoryCoordinates) (i : Fin 62) (E : ℝ)
    (hE : E ≤ 1 / 1000000000000000)
    (hc : ∀ j, -E ≤ Coordinates.rows ((gates i).selected j) h.vector) :
    (1568511 / 1000000000000000 : ℝ) < Coordinates.objectives i h.vector :=
  robust_for_physical_coordinates i h.vector E hE hc

end
