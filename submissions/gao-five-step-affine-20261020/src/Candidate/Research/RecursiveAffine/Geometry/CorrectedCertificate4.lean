theorem coordinate_identity : ∀ i : Fin 15,
    objective i = constant margin i + ∑ j, weights j*rows j i := by
  intro i
  fin_cases i <;> norm_num [objective, weights, rows, margin, constant, Fin.sum_univ_succ, Model.constraint01, Model.constraint35, Model.constraint36, Model.constraint37, Model.constraint38, Model.constraint39, Model.constraint40, Model.constraint41, Model.constraint42, Model.constraint43, Model.constraint44, Model.constraint45, Model.constraint46, Model.constraint47]

theorem weights_nonneg : ∀ j, 0 ≤ weights j := by
  intro j
  fin_cases j <;> norm_num [weights]

theorem corrected_margin_gt : (1249/10000000000 : ℚ) < margin := by
  norm_num [margin]

theorem corrected_mass_lt : (∑ j, weights j) < 349 := by
  norm_num [weights, Fin.sum_univ_succ]

theorem rows_selected : ∀ j, rows j = Model.constraint (selected j) := by
  intro j
  fin_cases j <;> rfl

/-- Only b_top and literal nonnegative-coordinate rows are used. -/
theorem prefix_admissible : ∀ j, (selected j).val = 1 ∨ 35 ≤ (selected j).val := by
  intro j
  fin_cases j <;> norm_num [selected]

def certificate : Certificate 14 14 where
  objective := objective
  rows := rows
  weights := weights
  margin := margin
  weights_nonneg := weights_nonneg
  coordinate_identity := coordinate_identity
  margin_gt := by norm_num [margin]
  mass_lt := by norm_num [weights, Fin.sum_univ_succ]

/-- Exact named coordinate semantics; the old junction expression is only
an algebraic starting point, and the native common-credit correction is explicit. -/
theorem meaning (x : Fin 14 → ℝ) :
    eval objective x = CorrectedPayment.paid4 x := by
  unfold CorrectedPayment.paid4
  have hOld : eval Certificate59.objective x = Coordinates.joint4 x := objective59_meaning x
  rw [← hOld]
  norm_num [eval, objective, Certificate59.objective, Fin.sum_univ_succ,
    CorrectedPayment.h, Coordinates.q4, Coordinates.rho,
    Coordinates.historicalReduction4, Coordinates.historicalMissing4,
    Coordinates.Red0, Coordinates.V0, Coordinates.Red1, Coordinates.V1, Coordinates.Red2, Coordinates.V2, Coordinates.Red3, Coordinates.V3]
  <;> ring

theorem robust_lower (x : Fin 14 → ℝ) (E : ℝ)
    (hE : E ≤ 1/1000000000000000)
    (hc : ∀ j, -E ≤ Coordinates.rows (selected j) x) :
    (124899651/1000000000000000 : ℝ) < CorrectedPayment.paid4 x := by
  rw [← meaning x]
  apply CorrectedPayment.uniform_robust_lower certificate corrected_margin_gt corrected_mass_lt x E hE
  intro j
  change -E ≤ eval (rows j) x
  rw [rows_selected, constraint_meaning]
  exact hc j

theorem positive (x : Fin 14 → ℝ) (E : ℝ)
    (hE : E ≤ 1/1000000000000000)
    (hc : ∀ j, -E ≤ Coordinates.rows (selected j) x) :
    0 < CorrectedPayment.paid4 x :=
  lt_trans (by norm_num) (robust_lower x E hE hc)

