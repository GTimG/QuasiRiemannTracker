import Candidate.Research.RecursiveAffine.Geometry.CorrectedPayment

set_option autoImplicit false
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace OAI.SevenEighths.Cycle153Geometry
noncomputable section
open scoped BigOperators
namespace CorrectedCertificate3

/-- Exact conservative native-payment objective at junction 3. -/
def objective : Affine 14 := ![(), (-), (), (), (6321537352409003363027258075418004981821989177923964218860441846902041025633/12429164483357532579559042387732532431222620425901771427133871764869800000000), 0, (2104523441/3800000000), (2104523441/3800000000), (2104523441/3800000000), 0, (), (478286206709247986146303493413985913956979344648257235073062286651142302853926917350000/214493263763737289677258182566982977578985701590440415001696990773971330154571674323061), (146859867550507812603587442819150000/63467873514784384226829031444440059), 0, ()]
def weights : Fin 11 → ℚ := ![(), (), (), (6321537352409003363027258075418004981821989177923964218860441846902041025633/12429164483357532579559042387732532431222620425901771427133871764869800000000), (2104523441/3800000000), (2104523441/3800000000), (2104523441/3800000000), (), (478286206709247986146303493413985913956979344648257235073062286651142302853926917350000/214493263763737289677258182566982977578985701590440415001696990773971330154571674323061), (146859867550507812603587442819150000/63467873514784384226829031444440059), ()]
def rows : Fin 11 → Affine 14 := ![Model.constraint01, Model.constraint35, Model.constraint36, Model.constraint37, Model.constraint39, Model.constraint40, Model.constraint41, Model.constraint43, Model.constraint44, Model.constraint45, Model.constraint47]
def selected : Fin 11 → Fin 48 := ![1, 35, 36, 37, 39, 40, 41, 43, 44, 45, 47]
def margin : ℚ := ()

theorem coordinate_identity : ∀ i : Fin 15,
    objective i = constant margin i + ∑ j, weights j*rows j i := by
  intro i
  fin_cases i <;> norm_num [objective, weights, rows, margin, constant, Fin.sum_univ_succ, Model.constraint01, Model.constraint35, Model.constraint36, Model.constraint37, Model.constraint39, Model.constraint40, Model.constraint41, Model.constraint43, Model.constraint44, Model.constraint45, Model.constraint47]

theorem weights_nonneg : ∀ j, 0 ≤ weights j := by
  intro j
  fin_cases j <;> norm_num [weights]

theorem corrected_margin_gt : (1249/10000000000 : ℚ) < margin := by
  norm_num [margin]

theorem corrected_mass_lt : (∑ j, weights j) < 349 := by
  norm_num [weights, Fin.sum_univ_succ]

theorem rows_selected : ∀ j, rows j = Model.constraint (selected j) := by
  intro j
  fin_cases j <;> rfl

/-- Only b_top and literal nonnegative-coordinate rows are used. -/
theorem prefix_admissible : ∀ j, (selected j).val = 1 ∨ 35 ≤ (selected j).val := by
  intro j
  fin_cases j <;> norm_num [selected]

def certificate : Certificate 14 11 where
  objective := objective
  rows := rows
  weights := weights
  margin := margin
  weights_nonneg := weights_nonneg
  coordinate_identity := coordinate_identity
  margin_gt := by norm_num [margin]
  mass_lt := by norm_num [weights, Fin.sum_univ_succ]

/-- Exact named coordinate semantics; the old junction expression is only
an algebraic starting point, and the native common-credit correction is explicit. -/
theorem meaning (x : Fin 14 → ℝ) :
    eval objective x = CorrectedPayment.paid3 x := by
  unfold CorrectedPayment.paid3
  have hOld : eval Certificate45.objective x = Coordinates.joint3 x := objective45_meaning x
  rw [← hOld]
  norm_num [eval, objective, Certificate45.objective, Fin.sum_univ_succ,
    CorrectedPayment.h, Coordinates.q3, Coordinates.rho,
    Coordinates.historicalReduction3, Coordinates.historicalMissing3,
    Coordinates.Red0, Coordinates.V0, Coordinates.Red1, Coordinates.V1, Coordinates.Red2, Coordinates.V2]
  <;> ring

theorem robust_lower (x : Fin 14 → ℝ) (E : ℝ)
    (hE : E ≤ 1/1000000000000000)
    (hc : ∀ j, -E ≤ Coordinates.rows (selected j) x) :
    (124899651/1000000000000000 : ℝ) < CorrectedPayment.paid3 x := by
  rw [← meaning x]
  apply CorrectedPayment.uniform_robust_lower certificate corrected_margin_gt corrected_mass_lt x E hE
  intro j
  change -E ≤ eval (rows j) x
  rw [rows_selected, constraint_meaning]
  exact hc j

theorem positive (x : Fin 14 → ℝ) (E : ℝ)
    (hE : E ≤ 1/1000000000000000)
    (hc : ∀ j, -E ≤ Coordinates.rows (selected j) x) :
    0 < CorrectedPayment.paid3 x :=
  lt_trans (by norm_num) (robust_lower x E hE hc)

end CorrectedCertificate3
end
