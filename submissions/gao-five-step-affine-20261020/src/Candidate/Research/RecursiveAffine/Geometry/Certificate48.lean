theorem coordinate_identity : ∀ i : Fin 15, objective i = constant margin i + ∑ j, weights j * rows j i := by
  intro i
  fin_cases i <;> norm_num [objective, weights, rows, margin, constant, Fin.sum_univ_succ, Model.constraint01, Model.constraint14, Model.constraint29, Model.constraint30, Model.constraint35, Model.constraint39, Model.constraint40, Model.constraint41, Model.constraint42, Model.constraint43, Model.constraint44, Model.constraint45, Model.constraint46, Model.constraint47]

theorem weights_nonneg : ∀ j, 0 ≤ weights j := by
