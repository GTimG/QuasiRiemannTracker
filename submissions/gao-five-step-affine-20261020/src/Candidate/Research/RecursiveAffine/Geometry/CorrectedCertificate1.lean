import Candidate.Research.RecursiveAffine.Geometry.CorrectedPayment

set_option autoImplicit false
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace OAI.SevenEighths.Cycle153Geometry
noncomputable section
open scoped BigOperators
namespace CorrectedCertificate1

/-- Exact conservative native-payment objective at junction 1. -/
def objective : Affine 14 := ![(), (-), (), 0, 0, 0, (2187111279769699157/5470481727000000000), 0, 0, 0, (176992427742020257272265758544251698320646996942266500000000000000000000/86676912942295510637709274845699196622093620191792362365107385589339077), 0, 0, 0, (176992427742020257272265758544251698320646996942266500000000000000000000/86676912942295510637709274845699196622093620191792362365107385589339077)]
def weights : Fin 5 → ℚ := ![(), (), (2187111279769699157/5470481727000000000), (176992427742020257272265758544251698320646996942266500000000000000000000/86676912942295510637709274845699196622093620191792362365107385589339077), (176992427742020257272265758544251698320646996942266500000000000000000000/86676912942295510637709274845699196622093620191792362365107385589339077)]
def rows : Fin 5 → Affine 14 := ![Model.constraint01, Model.constraint35, Model.constraint39, Model.constraint43, Model.constraint47]
def selected : Fin 5 → Fin 48 := ![1, 35, 39, 43, 47]
def margin : ℚ := ()

theorem coordinate_identity : ∀ i : Fin 15,
    objective i = constant margin i + ∑ j, weights j*rows j i := by
  intro i
  fin_cases i <;> norm_num [objective, weights, rows, margin, constant, Fin.sum_univ_succ, Model.constraint01, Model.constraint35, Model.constraint39, Model.constraint43, Model.constraint47]

theorem weights_nonneg : ∀ j, 0 ≤ weights j := by
  intro j
  fin_cases j <;> norm_num [weights]

theorem corrected_margin_gt : (1249/10000000000 : ℚ) < margin := by
  norm_num [margin]

theorem corrected_mass_lt : (∑ j, weights j) < 349 := by
  norm_num [weights, Fin.sum_univ_succ]

theorem rows_selected : ∀ j, rows j = Model.constraint (selected j) := by
  intro j
  fin_cases j <;> rfl

/-- Only b_top and literal nonnegative-coordinate rows are used. -/
theorem prefix_admissible : ∀ j, (selected j).val = 1 ∨ 35 ≤ (selected j).val := by
  intro j
  fin_cases j <;> norm_num [selected]

def certificate : Certificate 14 5 where
  objective := objective
  rows := rows
  weights := weights
  margin := margin
  weights_nonneg := weights_nonneg
  coordinate_identity := coordinate_identity
  margin_gt := by norm_num [margin]
  mass_lt := by norm_num [weights, Fin.sum_univ_succ]

/-- Exact named coordinate semantics; the old junction expression is only
an algebraic starting point, and the native common-credit correction is explicit. -/
theorem meaning (x : Fin 14 → ℝ) :
    eval objective x = CorrectedPayment.paid1 x := by
  unfold CorrectedPayment.paid1
  have hOld : eval Certificate13.objective x = Coordinates.joint1 x := objective13_meaning x
  rw [← hOld]
  norm_num [eval, objective, Certificate13.objective, Fin.sum_univ_succ,
    CorrectedPayment.h, Coordinates.q1, Coordinates.rho,
    Coordinates.historicalReduction1, Coordinates.historicalMissing1,
    Coordinates.Red0, Coordinates.V0]
  <;> ring

theorem robust_lower (x : Fin 14 → ℝ) (E : ℝ)
    (hE : E ≤ 1/1000000000000000)
    (hc : ∀ j, -E ≤ Coordinates.rows (selected j) x) :
    (124899651/1000000000000000 : ℝ) < CorrectedPayment.paid1 x := by
  rw [← meaning x]
  apply CorrectedPayment.uniform_robust_lower certificate corrected_margin_gt corrected_mass_lt x E hE
  intro j
  change -E ≤ eval (rows j) x
  rw [rows_selected, constraint_meaning]
  exact hc j

theorem positive (x : Fin 14 → ℝ) (E : ℝ)
    (hE : E ≤ 1/1000000000000000)
    (hc : ∀ j, -E ≤ Coordinates.rows (selected j) x) :
    0 < CorrectedPayment.paid1 x :=
  lt_trans (by norm_num) (robust_lower x E hE hc)

end CorrectedCertificate1
end
end OAI.SevenEighths.Cycle153Geometry

#print axioms OAI.SevenEighths.Cycle153Geometry.CorrectedCertificate1.robust_lower
