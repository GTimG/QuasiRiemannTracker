theorem margin_gt : (157 / 100000000000 : ℚ) < margin := by
  norm_num [margin]

theorem mass_lt : (∑ j, weights j) < 1489 := by
  norm_num [weights, Fin.sum_univ_succ]

theorem rows_selected : ∀ j, rows j = Model.constraint (selected j) := by
  intro j
