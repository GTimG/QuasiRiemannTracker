  fin_cases i <;> norm_num [objective, weights, rows, margin, constant, Fin.sum_univ_succ, Model.constraint01, Model.constraint02, Model.constraint07, Model.constraint09, Model.constraint39]

theorem weights_nonneg : ∀ j, 0 ≤ weights j := by
