/-- stage_1_short_positive; exact fixed-price input. -/
def objective : Affine 14 := ![( / ), (-241693076841523776633352547341874852106395670708614859248403930189834146971451716990375062025274283530254099500161043113 / 176384356735877765295472255405008100482598271349440411581039347160755920014368226187538094132797130198635158051206974000), (-99 / 200), 0, 0, 0, (-1 / 2), 0, 0, 0, (5499 / 2000), 0, 0, 0, (726732774158210518315032762169718411803259526908182159113168979673559344764544413925225901951588837382198119400145781013 / 176384356735877765295472255405008100482598271349440411581039347160755920014368226187538094132797130198635158051206974000)]

def weights : Fin 5 → ℚ := ![(84170777788311565841662350292139896342778908207899740468649362583265181947172076585364939687308347959865515192809911987 / 88192178367938882647736127702504050241299135674720205790519673580377960007184113093769047066398565099317579025603487000), (99 / 200), (1 / 2), (4499 / 1000), (4499 / 1000)]

def rows : Fin 5 → Affine 14 := ![Model.constraint00, Model.constraint08, Model.constraint09, Model.constraint43, Model.constraint47]

def selected : Fin 5 → Fin 48 := ![0, 8, 9, 43, 47]

def margin : ℚ := ( / )

theorem coordinate_identity : ∀ i : Fin 15, objective i = constant margin i + ∑ j, weights j * rows j i := by
  intro i
  fin_cases i <;> norm_num [objective, weights, rows, margin, constant, Fin.sum_univ_succ, Model.constraint00, Model.constraint08, Model.constraint09, Model.constraint43, Model.constraint47]

theorem weights_nonneg : ∀ j, 0 ≤ weights j := by
  intro j
  fin_cases j <;> norm_num [weights]

theorem margin_gt : (157 / 100000000000 : ℚ) < margin := by
  norm_num [margin]

theorem mass_lt : (∑ j, weights j) < 1489 := by
  norm_num [weights, Fin.sum_univ_succ]

theorem rows_selected : ∀ j, rows j = Model.constraint (selected j) := by
  intro j
  fin_cases j <;> rfl

theorem prefix_admissible : ∀ j, (selected j).val < 14 ∨ 35 ≤ (selected j).val := by
  intro j
  fin_cases j <;> norm_num [selected]

def certificate : Certificate 14 5 where
  objective := objective
  rows := rows
  weights := weights
  margin := margin
  weights_nonneg := weights_nonneg
  coordinate_identity := coordinate_identity
  margin_gt := margin_gt
  mass_lt := mass_lt

theorem positive (x : Fin 14 → ℝ) (E : ℝ) (hE : E ≤ 1 / 1000000000000000)
    (hc : ∀ j, -E ≤ eval (Model.constraint (selected j)) x) :
    0 < eval objective x := by
  apply certificate.positive_of_constraint_error x E hE
  intro j
  change -E ≤ eval (rows j) x
  rw [rows_selected]
  exact hc j

theorem robust_lower (x : Fin 14 → ℝ) (E : ℝ) (hE : E ≤ 1 / 1000000000000000)
    (hc : ∀ j, -E ≤ eval (Model.constraint (selected j)) x) :
    (1568511 / 1000000000000000 : ℝ) < eval objective x := by
  apply certificate.uniform_robust_lower x E hE
  intro j
  change -E ≤ eval (rows j) x
  rw [rows_selected]
  exact hc j

