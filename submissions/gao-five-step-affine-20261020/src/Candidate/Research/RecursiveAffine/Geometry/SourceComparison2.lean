def certificate : Certificate 14 8 where
  objective := objective
  rows := rows
  weights := weights
  margin := margin
  weights_nonneg := by intro j;fin_cases j <;> norm_num [weights]
  coordinate_identity := identity
  margin_gt := by norm_num [margin]
  mass_lt := by norm_num [weights,Fin.sum_univ_succ]

theorem rows_selected : ∀j,rows j=Model.constraint (selected j) := by
  intro j
  fin_cases j <;> rfl

theorem prefix_admissible : ∀j,(selected j).val<21 ∨ 35≤(selected j).val := by
  intro j
  fin_cases j <;> norm_num [selected]

theorem robust_lower (x : Fin 14 → ℝ) (E : ℝ) (hE : E≤1/1000000000000000)
    (hc : ∀j,-E≤eval (Model.constraint (selected j)) x) :
    (1568511/1000000000000000 : ℝ)<expression x := by
  rw [←meaning x]
  apply certificate.uniform_robust_lower x E hE
  intro j
  change -E≤eval (rows j) x
  rw [rows_selected]
  exact hc j

end
