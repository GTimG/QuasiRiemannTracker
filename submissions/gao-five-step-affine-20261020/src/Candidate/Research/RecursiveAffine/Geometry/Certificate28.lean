  fin_cases i <;> norm_num [objective, weights, rows, margin, constant, Fin.sum_univ_succ, Model.constraint01, Model.constraint14, Model.constraint16, Model.constraint35, Model.constraint39, Model.constraint40, Model.constraint43, Model.constraint47]

