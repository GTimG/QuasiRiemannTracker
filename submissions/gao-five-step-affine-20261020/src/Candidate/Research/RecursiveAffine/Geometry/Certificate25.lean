  fin_cases i <;> norm_num [objective, weights, rows, margin, constant, Fin.sum_univ_succ, Model.constraint01, Model.constraint02, Model.constraint07, Model.constraint15, Model.constraint16, Model.constraint39, Model.constraint40, Model.constraint44]

theorem weights_nonneg : ∀ j, 0 ≤ weights j := by
