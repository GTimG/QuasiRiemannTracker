/-- Source-only licences used by the literal selected-row producer.
Every field is generated by the actual fixed-threshold native source,
not an energy bound, count bound, or assumed recursive conclusion. -/
structure RootSelectedPrimitivePacket
    (C : SourceContext (α:=alpha) M H)(s : Input alpha)(p : Profiles (1/4) (9/4))
    (Cs : ℝ)(caps : GeometryAffineLowSourceGates s p Cs C.globalBase)
    (epsNode : ℝ)(budget : ℕ)(mesh : ℝ)(hmesh : 0≤ mesh) where
  gates : ActualRootPaidGateAtBinPackage C.globalBase C.globalBase_gt_one budget s C.originalWeight p Cs caps
  prefixSmall : Real.logb C.globalBase 4+2*(Fintype.card alpha:ℝ)*Real.logb C.globalBase (9/4)+(nativeMu/64)/2≤1
  fit : 1+Real.logb C.globalBase (s.η.modulus.absNorm:ℝ)≤1+(nativeMu/8)/2
  constants : Real.logb C.globalBase CenteredMomentFirstPhysicalSource.fixedPresentationCost+
    2*(Fintype.card alpha:ℝ)*Real.logb C.globalBase (9/4)+Real.logb C.globalBase 1+
    Real.logb C.globalBase (4*(CenteredMomentSecondRadicalBudget.fixedFactor:ℝ))≤(nativeMu/8)/2
  pad : supportPadding (Fintype.card alpha) (9/4) s.b₁ s.b₂ C.globalBase≤nativeMu/8
  omega : frequencyLoss C.globalBase 32 (nativeMu/64)+nativeMu/8≤(1/1000000000000000:ℝ)
  finite : Real.logb C.globalBase 128+actualRootSourcePad C s≤1/100000000000000000000
  fee : ∀(R : Finset alpha)
    (hd : (∑i∈R,C.originalWeight i)≤rootDetectorDeletion C.originalWeight+mesh),
    let f:=actualRootNativeFeeAtMesh C s epsNode budget R mesh hmesh hd
    f.amount≤1/1000000000000000 ∧
      (rootDetectorDeletion C.originalWeight≤∑i∈R,C.originalWeight i→f.junction*f.modelDeletion+f.amount≤2)
  masks : ∀(reflected second : Bool)(firstHeight : ℝ)(key : ℤ×(Fin 5→ℤ))
    {Label : Type}[Fintype Label]
    (firstIndex : Label→GeometryLowFirstIndex reflected s 1 1 (C.globalBase^(1:ℝ)) C.globalBase (nativeMu/64)
      (Real.rpow_pos_of_pos (zero_lt_one.trans C.globalBase_gt_one) _) key),
    (∀l,frozenCoefficient (firstIndex l).2.val
      (geometryColumnIdeal reflected s 1 1 (C.globalBase^(1:ℝ)) C.globalBase (nativeMu/64)
        (Real.rpow_pos_of_pos (zero_lt_one.trans C.globalBase_gt_one) _) key (firstIndex l).1.val)
      1 s.ν s.W s.P≠0)→
    ∀r : NativeLowRows reflected s 1 1 C.globalBase 1 (rootSourceAmp C.originalWeight)
      (nativeMu/64) (nativeMu/8) (9/4) firstHeight (Fintype.card alpha)
      C.globalBase_gt_one key caps.zero₁ caps.zero₂ firstIndex,
    let datum:=geometryLowSecondDatum reflected s 1 1 C.globalBase 1 (rootSourceAmp C.originalWeight)
      (nativeMu/64) (nativeMu/8) (9/4) firstHeight (Fintype.card alpha)
      C.globalBase_gt_one key (firstIndex r.val.1) caps.zero₁ caps.zero₂ r.val.2
    let E:=if second then datum.D else datum.C
    datum.R*E≠0 ∧ ((datum.R*E).absNorm:ℝ)≤C.globalBase^(28:ℝ) ∧ Supported E ∧ datum.seed∣E

/-- One fixed cutoff constructs all literal root bin, mesh fee, mask and
finite source licences, before the moving context, profile and labels. -/
theorem eventually_actual_root_selected_primitives
    (etaSeed : Character)(epsNode : ℝ)(heps : 0<epsNode)(budget : ℕ) :
    ∀ᶠZ : ℝ in atTop,1<Z ∧
    ∀(C : SourceContext (α:=alpha) M H)(s : Input alpha)
      (p : Profiles (1/4) (9/4))(Cs : ℝ)(caps : GeometryAffineLowSourceGates s p Cs C.globalBase),
      C.globalBase=Z→s.η=etaSeed→s.b₁=(9/4:ℝ)→s.b₂=(9/4:ℝ)→
      C.slotMesh≤localSlotMesh epsNode→Fintype.card alpha≤budget→
      (∀i,s.P i=C.globalBase^(C.originalWeight i))→
      Cycle63.AffineLedger.PlainWindow (length C.globalBase s.X₁) (length C.globalBase s.X₂) (∑i,C.originalWeight i)→
    ∀(mesh : ℝ)(hmesh : 0≤ mesh),mesh≤C.slotMesh→
      Nonempty (RootSelectedPrimitivePacket C s p Cs caps epsNode budget mesh hmesh) :=by
  filter_upwards [eventual_actual_root_selected_paid_gates_at_bin (Current:=alpha) etaSeed budget,
    eventually_actual_root_native_thresholds etaSeed budget,
    eventually_actual_root_native_fee_at_mesh (alpha:=alpha) (M:=M) (H:=H) epsNode heps budget,
    eventually_actual_native_pad budget,eventual_geometry_small_frequency nativeMu nativeMu_pos,
    eventual_actual_selected_all_row_masks budget] with Z hg ht hf hp ho hm
  refine ⟨hg.1,?_⟩
  intro C s p Cs caps hbase heta hb1 hb2 hcontext hcard hscale hwindow mesh hmesh hmeshCap
  subst Z
  have hcardR : (Fintype.card alpha:ℝ)≤budget:=by exact_mod_cast hcard
  have hlog : 0≤Real.logb C.globalBase (9/4):=Real.logb_nonneg C.globalBase_gt_one (by norm_num)
  have hcost : 2*(Fintype.card alpha:ℝ)*Real.logb C.globalBase (9/4)≤
      2*(budget:ℝ)*Real.logb C.globalBase (9/4):=by nlinarith only [mul_le_mul_of_nonneg_right hcardR hlog]
  have hprefix:=ht.2.2.1
  have hconstants:=ht.2.2.2.1
  have hpadFull:=hp.2 1 (by norm_num) (Fintype.card alpha) hcard (9/4) s.b₁ s.b₂
    (by norm_num) le_rfl hb1.le hb2.le
  rw [Real.rpow_one] at hpadFull
  have hlog128 : 0≤Real.logb C.globalBase 128:=Real.logb_nonneg C.globalBase_gt_one (by norm_num)
  have hgrid0 : 0≤252/(gridSize:ℝ):=by positivity
  have hfinite : Real.logb C.globalBase 128+actualRootSourcePad C s≤1/100000000000000000000:=by
    dsimp only [actualRootSourcePad]
    linarith only [hpadFull,hgrid0]
  have hpad : supportPadding (Fintype.card alpha) (9/4) s.b₁ s.b₂ C.globalBase≤nativeMu/8:=by
    change actualRootSourcePad C s≤_
    have htiny : (1/100000000000000000000:ℝ)≤nativeMu/8:=by norm_num [nativeMu,primitiveError]
    linarith only [hfinite,hlog128,htiny]
  have hfit:=ht.2.1
  rw [←heta] at hfit
  have homega:=ho.2.2
  refine ⟨{gates:=?_,prefixSmall:=?_,fit:=?_,constants:=?_,pad:=hpad,omega:=?_,finite:=hfinite,fee:=?_,masks:=?_}⟩
  · have hh:=hg.2.2 C.globalBase_gt_one s C.originalWeight p Cs caps hcard C.originalWeight_nonneg hscale hwindow
    exact hh
  · linarith only [hprefix,hcost]
  · linarith only [hfit]
  · linarith only [hconstants,hcost]
  · exact homega.trans (by norm_num [nativeMu,primitiveError])
  · intro R hd
    have hh:=hf.2 C s rfl hb1 hb2 hcontext hcard mesh hmesh hmeshCap R hd
    exact ⟨by simpa only [show (10:ℝ)^15=1000000000000000 by norm_num] using hh.2.1,
      fun hc=>hh.2.2 hc hwindow⟩
  · intro reflected second firstHeight key Label _ firstIndex hfirst r datum E
    have hvolume3 : volume s≤C.globalBase^(3:ℝ):=
      caps.volume.trans (Real.rpow_le_rpow_of_exponent_le C.globalBase_gt_one.le (by norm_num))
    have hmask:=hm.2 reflected second s 1 1 1 (rootSourceAmp C.originalWeight) (nativeMu/64) (nativeMu/8)
      firstHeight 0 C.globalBase_gt_one hcard caps.endpoints squarefree_one one_ne_zero (by norm_num)
      (by simp only [map_one,Nat.cast_one,Real.rpow_zero,le_refl])
      caps.zero₁ caps.zero₂ caps.sourceCap hvolume3 key firstIndex hfirst r
    exact ⟨hmask.1,hmask.2.2.1,hmask.2.2.2.2.2.1,hmask.2.2.2.2.2.2⟩
end
