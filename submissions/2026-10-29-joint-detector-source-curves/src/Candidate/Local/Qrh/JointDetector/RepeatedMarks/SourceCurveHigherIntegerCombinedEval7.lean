theorem eval_combinedPower7 (p : Params) (u : ℝ) :
 SourceCurveHigherCertificate.eval (fun j=>(combinedPower p (7:Fin 10) j).evalR) u=combinedGate p.toReal (7:Fin 10) u := by
 have hd : (p.den:ℝ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt p.den_pos)
 rw [show SourceCurveHigherCertificate.eval (fun j=>(combinedPower p (7:Fin 10) j).evalR) u=
   SourceCurveHigherCertificate.eval (fun j=>(combinedNumerator p (7:Fin 10) j:ℝ)) u/(denominator p:ℝ) from
   eval_mk (combinedNumerator p (7:Fin 10)) (denominator p) (denominator_pos p) u]
