theorem box001_bound {δ p:ℝ} (hd:δ∈Set.Icc (0/1:ℝ) (3/8:ℝ)) (hp:p∈Set.Icc (0/1:ℝ) (1/2:ℝ)) :
 Ebase (edgeD .oldSmall) (edgeC .oldSmall) δ p + (3/4)*edgeD .oldSmall*
   (@GenericCount.envelope Das.QRH.ReturnB.finalCountScheme kappa δ p) < theta-rowFee := by
 have hdall : δ∈Set.Icc (0:ℝ) (3/4) := ⟨by linarith [hd.1],by linarith [hd.2]⟩
 have hpall : p∈Set.Icc (0:ℝ) (1/2) := ⟨by linarith [hp.1],by linarith [hp.2]⟩
 have hr : @GenericCount.envelope Das.QRH.ReturnB.finalCountScheme kappa δ p ≤
   countN .old δ p / countJ .old δ p := by
  exact finiteEnvelope_le_old hdall hpall
 exact exponent_lt_of_margin (countJ_pos .old hdall hpall) (row001_pos hd hp) hr
