OAI.SevenEighths.Parameters.exists_distinct_slot_lengths_total_perturbed (Ltotal L : ℝ) (hLtotal : 0 < Ltotal)
  (hL : 0 < L) :
  ∃ N, 0 < N ∧ ∃ ell, Function.Injective ell ∧ (∀ (j : Fin N), 0 < ell j ∧ ell j < L) ∧ ∑ j, ell j = Ltotal
OAI.SevenEighths.Parameters.exists_physical_slot_lengths_total_perturbed (Ltotal dmin dmax mesh R : ℝ)
  (hLtotal : 0 < Ltotal) (hdmin : 0 < dmin) (hd : dmin ≤ dmax) (hm : 0 < mesh) (hR : 0 < R) :
  ∃ N,
    0 < N ∧
      ∃ ell rmin,
        0 < rmin ∧
          Function.Injective ell ∧
            ∑ j, ell j = Ltotal ∧
              (∀ (j : Fin N), 0 < ell j ∧ dmax * rmin ≤ ell j ∧ ell j ≤ dmin * mesh ∧ ell j ≤ dmin * R) ∧
                ∀ (d : ℝ), dmin ≤ d → d ≤ dmax → ∀ (j : Fin N), rmin ≤ ell j / d ∧ ell j / d ≤ mesh ∧ ell j / d ≤ R
